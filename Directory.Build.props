<Project>

  <PropertyGroup>
    <!-- Supply chain: grava as versoes resolvidas de cada projeto em packages.lock.json.
         O CI restaura em modo travado (restore com a flag locked-mode), entao toda alteracao
         de PackageReference exige regenerar os locks com "dotnet restore /p:RestoreForceEvaluate=true"
         (ou "dotnet restore" com a flag force-evaluate). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Issue #94 (achado A03-1): antes, o gate de vulnerabilidade do CI dependia de um
         step próprio com "continue-on-error: true" — mesmo uma vulnerabilidade Crítica
         introduzida por um PR novo passaria sem impedir o merge. NuGetAuditMode=all audita
         também dependências transitivas (não só diretas); NuGetAuditLevel=low reporta a
         partir da severidade mais baixa. WarningsAsErrors para os 4 códigos do NuGet Audit
         (NU1901=Low, NU1902=Moderate, NU1903=High, NU1904=Critical) faz "dotnet restore"
         falhar de verdade ao encontrar um advisory novo — o build não avança, sem depender
         de nenhum parsing de saída (resolve também o achado A03-2: a checagem antiga usava
         grep sobre texto livre, não um contrato da ferramenta).
         Testado empiricamente: com isto habilitado, restore continua limpo (nenhum advisory
         conhecido no momento — issue #95 resolvida); introduzir uma dependência com advisory
         conhecido faz o restore falhar com NU190x. -->
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

</Project>
