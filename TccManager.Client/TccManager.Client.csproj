<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Issue #94 (achado A03-4): reativado agora que o repositório fixa a versão do SDK via
         global.json (rollForward: latestFeature a partir de 9.0.100) — a causa raiz do
         problema original (o SDK do Blazor WebAssembly injeta Microsoft.NET.ILLink.Tasks e
         Microsoft.NET.Sdk.WebAssembly.Pack com a versão vindo do SDK instalado, então o lock
         quebrava sempre que a versão do SDK da máquina/runner mudasse) deixa de se aplicar
         dentro da mesma feature band. Antes, este projeto dependia implicitamente do
         ProjectReference de TccManager.Tests para ter cobertura de hash das dependências —
         sem sinal nenhum no CI se essa referência algum dia fosse removida. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Blazored.LocalStorage" Version="4.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.4" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.4" />
    <PackageReference Include="Radzen.Blazor" Version="11.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TccManager.Shared\TccManager.Shared.csproj" />
  </ItemGroup>

</Project>
