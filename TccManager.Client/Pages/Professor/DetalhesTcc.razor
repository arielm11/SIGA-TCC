@page "/professor/tcc/{TccId:int}"
@using Microsoft.AspNetCore.Authorization
@using TccManager.Shared.Models
@using TccManager.Shared.DTOs
@using TccManager.Shared.Enums
@attribute [Authorize(Roles = "Professor")]
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject DialogService DialogService
@inject NotificationService NotificationService

<PageTitle>Detalhes do TCC</PageTitle>

<RadzenStack Gap="1.5rem">
    <RadzenButton Text="Voltar ao Dashboard" Icon="arrow_back" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined"
                  Click='@(() => Navigation.NavigateTo("/professor/dashboard"))' style="align-self: flex-start;" />

    @if (carregando)
    {
        <RadzenStack AlignItems="AlignItems.Center" Gap="1rem" class="rz-p-6">
            <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Mode="ProgressBarMode.Indeterminate" />
            <RadzenText TextStyle="TextStyle.Body2" class="rz-my-0">Carregando dados do orientando...</RadzenText>
        </RadzenStack>
    }
    else if (tcc != null)
    {
        <RadzenCard Variant="Variant.Outlined" class="rz-shadow-2">
            <RadzenRow Gap="1rem">
                <RadzenColumn SizeMD="8" SizeXS="12">
                    <RadzenText TextStyle="TextStyle.H5" class="rz-my-0">@tcc.Titulo</RadzenText>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.4rem" class="rz-mt-1">
                        <RadzenIcon Icon="person" />
                        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-my-0">Aluno: @tcc.Aluno?.Nome</RadzenText>
                    </RadzenStack>
                    <RadzenText class="rz-mt-3 rz-mb-3"><strong>Resumo:</strong> @tcc.Resumo</RadzenText>
                    <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@($"Status: {tcc.Status}")" />
                </RadzenColumn>

                <RadzenColumn SizeMD="4" SizeXS="12" class="rz-text-align-end">
                    @if (tcc.Status == StatusTcc.Aprovado || tcc.Status == StatusTcc.EmAndamento)
                    {
                        @* Issue #81 (D7): "Dar Aceite Final" passa a exigir uma Final APROVADA,
                           não apenas presente — sem isso o Professor contornaria o próprio
                           veredito de rejeição. A legenda distingue os três casos possíveis. *@
                        var finalMaisRecente = tcc.Entregas
                            .Where(e => e.Tipo == TipoEntrega.Final)
                            .OrderByDescending(e => e.DataEnvio)
                            .FirstOrDefault();
                        var temFinalAprovada = tcc.Entregas.Any(e => e.Tipo == TipoEntrega.Final && e.Status == StatusEntrega.Aprovada);

                        <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.End" Gap="0.5rem">
                            <RadzenButton Text="Dar Aceite Final" Icon="workspace_premium" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Large"
                                          Disabled="@(!temFinalAprovada || processandoAceite)" IsBusy="processandoAceite" BusyText="Processando..."
                                          Click="@DarAceiteFinal" />

                            @if (!temFinalAprovada)
                            {
                                <RadzenText TextStyle="TextStyle.Caption" class="rz-my-0">
                                    @if (finalMaisRecente == null)
                                    {
                                        @:Aguardando envio da Versão Final pelo aluno.
                                    }
                                    else if (finalMaisRecente.Status == StatusEntrega.Rejeitada)
                                    {
                                        @:A versão final foi rejeitada. Aguarde o novo envio do aluno.
                                    }
                                    else
                                    {
                                        @:A versão final ainda não foi avaliada. Aprove a entrega final antes de conceder o aceite.
                                    }
                                </RadzenText>
                            }
                        </RadzenStack>
                    }
                    else if (tcc.Status == StatusTcc.AguardandoDefesa)
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" ShowIcon="true">
                            Aceite Final Concedido
                        </RadzenAlert>
                    }
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>

        <RadzenTabs RenderMode="TabRenderMode.Client">
            <Tabs>
                <RadzenTabsItem Text="Entregas do Aluno" Icon="folder_open">
                    @if (!tcc.Entregas.Any())
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Secondary" Variant="Variant.Flat" ShowIcon="true">
                            Este aluno ainda não enviou nenhum arquivo.
                        </RadzenAlert>
                    }
                    else
                    {
                        <RadzenStack Gap="1rem">
                            @foreach (var entrega in tcc.Entregas)
                            {
                                @* Issue #81 (D9/D8): botões de veredito só aparecem com o TCC em
                                   Aprovado/EmAndamento, e ficam ocultos para uma entrega Final já
                                   Rejeitada (terminal — o aluno já reenviou uma nova Final). *@
                                var podeAlterarVeredito = (tcc.Status == StatusTcc.Aprovado || tcc.Status == StatusTcc.EmAndamento)
                                    && !(entrega.Tipo == TipoEntrega.Final && entrega.Status == StatusEntrega.Rejeitada);

                                <RadzenCard Variant="Variant.Outlined">
                                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Start" Gap="1rem">
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                                <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-my-0">@entrega.Titulo</RadzenText>
                                                <RadzenBadge BadgeStyle="BadgeStyle.Secondary" Text="@entrega.Tipo.ToString()" />
                                                <RadzenBadge BadgeStyle="@BadgeStyleParaStatusEntrega(entrega.Status)" Text="@TextoStatusEntrega(entrega.Status)" />
                                            </RadzenStack>
                                            <RadzenText TextStyle="TextStyle.Caption" class="rz-my-0">Enviado em: @entrega.DataEnvio.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</RadzenText>

                                            @if (!string.IsNullOrEmpty(entrega.Feedback))
                                            {
                                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem" class="rz-mt-1">
                                                    <RadzenIcon Icon="check_circle" IconColor="var(--rz-success)" />
                                                    <RadzenText TextStyle="TextStyle.Body2" class="rz-my-0">Avaliado (Nota: @(entrega.Nota?.ToString() ?? "N/A"))</RadzenText>
                                                </RadzenStack>
                                            }
                                            else
                                            {
                                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem" class="rz-mt-1">
                                                    <RadzenIcon Icon="schedule" IconColor="var(--rz-warning)" />
                                                    <RadzenText TextStyle="TextStyle.Body2" class="rz-my-0">Aguardando Avaliação</RadzenText>
                                                </RadzenStack>
                                            }
                                        </RadzenStack>

                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="rz-flex-wrap">
                                            <button type="button" @onclick="@(() => BaixarArquivoEntrega(entrega))" disabled="@(entregaIdBaixando == entrega.Id)"
                                                    style="display:inline-flex; align-items:center; gap:0.4rem; padding: 0.35rem 0.9rem; border: 1px solid var(--rz-primary); border-radius: 4px; background:none; color: var(--rz-primary); text-decoration:none; font-weight:500; white-space:nowrap; cursor:pointer;">
                                                <RadzenIcon Icon="download" />
                                                @(entregaIdBaixando == entrega.Id ? "Baixando..." : "Baixar Arquivo")
                                            </button>
                                            <RadzenButton Text="@(string.IsNullOrEmpty(entrega.Feedback) ? "Avaliar" : "Editar Avaliação")" Icon="chat"
                                                          ButtonStyle="ButtonStyle.Success" Click="@(() => AbrirFormFeedback(entrega))" />
                                            @if (podeAlterarVeredito)
                                            {
                                                <RadzenButton Text="Aprovar" Icon="check_circle" ButtonStyle="ButtonStyle.Success" Variant="Variant.Outlined"
                                                              Disabled="@(entregaIdProcessandoVeredito == entrega.Id)"
                                                              Click="@(() => AprovarEntrega(entrega))" />
                                                <RadzenButton Text="Rejeitar" Icon="cancel" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined"
                                                              Disabled="@(entregaIdProcessandoVeredito == entrega.Id)"
                                                              Click="@(() => AbrirRejeicaoEntrega(entrega))" />
                                            }
                                        </RadzenStack>
                                    </RadzenStack>

                                    @if (entregaEmAvaliacao == entrega.Id)
                                    {
                                        <RadzenCard Variant="Variant.Flat" class="rz-mt-3">
                                            <EditForm Model="feedbackAtual" OnValidSubmit="() => SalvarFeedback(entrega.Id)">
                                                <DataAnnotationsValidator />
                                                <RadzenRow Gap="1rem">
                                                    <RadzenColumn SizeMD="3" SizeXS="12">
                                                        <RadzenFormField Text="Nota (Opcional, 0 a 10)" Variant="Variant.Outlined" style="width: 100%;">
                                                            <RadzenNumeric TValue="decimal?" @bind-Value="feedbackAtual.Nota" Min="0" Max="10" Step="0.1" style="width: 100%;" />
                                                        </RadzenFormField>
                                                    </RadzenColumn>
                                                    <RadzenColumn SizeMD="9" SizeXS="12">
                                                        <RadzenFormField Text="Comentários / Parecer" Variant="Variant.Outlined" style="width: 100%;">
                                                            <RadzenTextArea @bind-Value="feedbackAtual.Feedback" Rows="3" style="width: 100%;" />
                                                        </RadzenFormField>
                                                        <ValidationMessage For="@(() => feedbackAtual.Feedback)" />
                                                    </RadzenColumn>
                                                </RadzenRow>
                                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="rz-mt-2">
                                                    <RadzenButton Text="Cancelar" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Click="@FecharFormFeedback" />
                                                    <RadzenButton ButtonType="ButtonType.Submit" Text="Salvar Feedback" Icon="save" ButtonStyle="ButtonStyle.Success"
                                                                  IsBusy="salvando" BusyText="Salvando..." Disabled="@salvando" />
                                                </RadzenStack>
                                            </EditForm>
                                        </RadzenCard>
                                    }
                                </RadzenCard>
                            }
                        </RadzenStack>
                    }
                </RadzenTabsItem>

                <RadzenTabsItem Text="Registo de Reuniões" Icon="event">
                    <RadzenCard Variant="Variant.Outlined" class="@(acompanhamentoEmEdicaoId.HasValue ? "rz-border-color-warning" : "")">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-3">
                            <RadzenIcon Icon="@(acompanhamentoEmEdicaoId.HasValue ? "edit_note" : "add_circle")" />
                            <RadzenText TextStyle="TextStyle.H6" class="rz-my-0">@(acompanhamentoEmEdicaoId.HasValue ? "Editar Ata de Reunião" : "Nova Ata de Reunião")</RadzenText>
                        </RadzenStack>

                        <EditForm Model="novoAcompanhamento" OnValidSubmit="SalvarAcompanhamento">
                            <DataAnnotationsValidator />
                            <RadzenRow Gap="1rem">
                                <RadzenColumn SizeMD="4" SizeXS="12">
                                    <RadzenFormField Text="Data da Reunião" Variant="Variant.Outlined" style="width: 100%;">
                                        <RadzenDatePicker TValue="DateTime" @bind-Value="novoAcompanhamento.DataReuniao" ShowTime="false"
                                                          DateFormat="dd/MM/yyyy" style="width: 100%;" />
                                    </RadzenFormField>
                                    <ValidationMessage For="@(() => novoAcompanhamento.DataReuniao)" />
                                </RadzenColumn>
                            </RadzenRow>
                            <div class="rz-mt-3">
                                <RadzenFormField Text="Ata / Assuntos Discutidos" Variant="Variant.Outlined" style="width: 100%;">
                                    <RadzenTextArea @bind-Value="novoAcompanhamento.Ata" Rows="4" style="width: 100%;" />
                                </RadzenFormField>
                                <ValidationMessage For="@(() => novoAcompanhamento.Ata)" />
                            </div>

                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="rz-mt-3">
                                @if (acompanhamentoEmEdicaoId.HasValue)
                                {
                                    <RadzenButton Text="Cancelar Edição" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Click="@CancelarEdicaoAcompanhamento" />
                                }
                                <RadzenButton ButtonType="ButtonType.Submit" Text="@(acompanhamentoEmEdicaoId.HasValue ? "Salvar Alterações" : "Gravar Registo")" Icon="save"
                                              ButtonStyle="ButtonStyle.Primary" IsBusy="salvandoAcompanhamento" BusyText="Salvando..." Disabled="@salvandoAcompanhamento" />
                            </RadzenStack>
                        </EditForm>
                    </RadzenCard>

                    <RadzenText TextStyle="TextStyle.H6" class="rz-mt-4 rz-mb-2">
                        <RadzenIcon Icon="history_edu" /> Histórico de Reuniões
                    </RadzenText>

                    @if (!tcc.Acompanhamentos.Any())
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Secondary" Variant="Variant.Flat" ShowIcon="true">
                            Nenhum registo de acompanhamento efetuado até ao momento.
                        </RadzenAlert>
                    }
                    else
                    {
                        <RadzenAccordion>
                            <Items>
                                @foreach (var ata in tcc.Acompanhamentos)
                                {
                                    <RadzenAccordionItem Text="@($"Reunião de {ata.DataReuniao.ToLocalTime():dd/MM/yyyy}")" Icon="event_available">
                                        <p style="white-space: pre-line;">@ata.Ata</p>
                                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="rz-mt-2">
                                            <RadzenButton Text="Editar" Icon="edit" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Size="ButtonSize.Small"
                                                          Click="@(() => PrepararEdicaoAcompanhamento(ata))" />
                                            <RadzenButton Text="Excluir" Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Size="ButtonSize.Small"
                                                          Click="@(() => ExcluirAcompanhamento(ata.Id))" />
                                        </RadzenStack>
                                    </RadzenAccordionItem>
                                }
                            </Items>
                        </RadzenAccordion>
                    }
                </RadzenTabsItem>
            </Tabs>
        </RadzenTabs>
    }
</RadzenStack>

@code {
    [Parameter]
    public int TccId { get; set; }

    private bool carregando = true;
    private bool salvando = false;
    private Tcc? tcc;

    private int? entregaEmAvaliacao;
    private FeedbackDto feedbackAtual = new();
    private int? entregaIdBaixando;

    private AcompanhamentoDto novoAcompanhamento = new();
    private bool salvandoAcompanhamento = false;
    private int? acompanhamentoEmEdicaoId = null;

    private bool processandoAceite = false;
    private int? entregaIdProcessandoVeredito;

    protected override async Task OnInitializedAsync()
    {
        await CarregarTcc();
    }

    // Download autenticado do arquivo da entrega (o endpoint estático sem autenticação foi
    // removido; agora exige Bearer token, por isso é buscado via HttpClient em vez de <a href>).
    private async Task BaixarArquivoEntrega(Entrega entrega)
    {
        entregaIdBaixando = entrega.Id;
        try
        {
            var response = await Http.GetAsync($"api/tcc/entregas/{entrega.Id}/download");

            if (response.IsSuccessStatusCode)
            {
                var bytes = await response.Content.ReadAsByteArrayAsync();
                var base64 = Convert.ToBase64String(bytes);
                var extensao = Path.GetExtension(entrega.ArquivoCaminho);
                var nomeArquivo = $"entrega-{entrega.Id}{extensao}";
                await JSRuntime.InvokeVoidAsync("downloadFileFromBytes", nomeArquivo, "application/octet-stream", base64);
            }
            else
            {
                var detalhe = response.StatusCode switch
                {
                    System.Net.HttpStatusCode.Forbidden => "Você não tem permissão para baixar este arquivo.",
                    System.Net.HttpStatusCode.NotFound => "Arquivo não encontrado.",
                    _ => "Não foi possível baixar o arquivo. Tente novamente mais tarde."
                };

                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Erro ao baixar arquivo",
                    Detail = detalhe,
                    Duration = 5000
                });
            }
        }
        catch
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Erro de conexão",
                Detail = "Erro de conexão ao baixar o arquivo.",
                Duration = 5000
            });
        }
        finally
        {
            entregaIdBaixando = null;
        }
    }

    private async Task CarregarTcc()
    {
        carregando = true;
        try
        {
            tcc = await Http.GetFromJsonAsync<Tcc>($"api/orientador/tcc/{TccId}");
        }
        catch
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Erro",
                Detail = "Erro ao carregar os dados.",
                Duration = 5000
            });
        }
        finally { carregando = false; }
    }

    private void AbrirFormFeedback(Entrega entrega)
    {
        entregaEmAvaliacao = entrega.Id;

        feedbackAtual = new FeedbackDto
        {
            Feedback = entrega.Feedback ?? "",
            Nota = entrega.Nota
        };
    }

    private void FecharFormFeedback()
    {
        entregaEmAvaliacao = null;
        feedbackAtual = new();
    }

    private async Task SalvarFeedback(int idEntrega)
    {
        salvando = true;
        try
        {
            var response = await Http.PostAsJsonAsync($"api/orientador/entregas/{idEntrega}/feedback", feedbackAtual);

            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Avaliação salva",
                    Detail = "Avaliação salva com sucesso!",
                    Duration = 4000
                });
                FecharFormFeedback();
                await CarregarTcc();
            }
            else
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Erro",
                    Detail = "Erro ao salvar a avaliação.",
                    Duration = 5000
                });
            }
        }
        finally { salvando = false; }
    }

    private async Task SalvarAcompanhamento()
    {
        salvandoAcompanhamento = true;
        try
        {
            HttpResponseMessage response;

            if (acompanhamentoEmEdicaoId.HasValue)
            {
                // Edição (PUT)
                response = await Http.PutAsJsonAsync($"api/orientador/tcc/{TccId}/acompanhamentos/{acompanhamentoEmEdicaoId.Value}", novoAcompanhamento);
            }
            else
            {
                // Criação (POST)
                response = await Http.PostAsJsonAsync($"api/orientador/tcc/{TccId}/acompanhamentos", novoAcompanhamento);
            }

            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Ata salva",
                    Detail = "Ata de reunião salva com sucesso!",
                    Duration = 4000
                });
                CancelarEdicaoAcompanhamento();
                await CarregarTcc();
            }
            else
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Erro",
                    Detail = "Erro ao guardar o acompanhamento.",
                    Duration = 5000
                });
            }
        }
        finally { salvandoAcompanhamento = false; }
    }

    private void PrepararEdicaoAcompanhamento(Acompanhamento ata)
    {
        acompanhamentoEmEdicaoId = ata.Id;
        novoAcompanhamento = new AcompanhamentoDto
        {
            DataReuniao = ata.DataReuniao,
            Ata = ata.Ata
        };

        // Cosmético (preservado da versão anterior): rola a página para o topo ao abrir a edição.
        _ = JSRuntime.InvokeVoidAsync("window.scrollTo", 0, 0);
    }

    private void CancelarEdicaoAcompanhamento()
    {
        acompanhamentoEmEdicaoId = null;
        novoAcompanhamento = new AcompanhamentoDto();
    }

    private async Task ExcluirAcompanhamento(int idAcompanhamento)
    {
        var confirmado = await DialogService.Confirm(
            "Tem certeza que deseja excluir esta ata? Esta ação não pode ser desfeita.",
            "Excluir ata",
            new ConfirmOptions { OkButtonText = "Excluir", CancelButtonText = "Cancelar" });

        if (confirmado != true) return;

        try
        {
            var response = await Http.DeleteAsync($"api/orientador/tcc/{TccId}/acompanhamentos/{idAcompanhamento}");

            if (response.IsSuccessStatusCode)
            {
                await CarregarTcc();
            }
            else
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Erro",
                    Detail = "Erro ao excluir o acompanhamento.",
                    Duration = 5000
                });
            }
        }
        catch
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Erro de conexão",
                Detail = "Erro de conexão ao excluir.",
                Duration = 5000
            });
        }
    }

    private async Task DarAceiteFinal()
    {
        var confirmado = await DialogService.Confirm(
            "Tem certeza que deseja dar o Aceite Final? Isso enviará o TCC para a Coordenação agendar a Banca.",
            "Dar aceite final",
            new ConfirmOptions { OkButtonText = "Confirmar", CancelButtonText = "Cancelar" });

        if (confirmado != true) return;

        processandoAceite = true;
        try
        {
            var response = await Http.PostAsync($"api/orientador/tcc/{TccId}/aceite-final", null);

            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Aceite concedido",
                    Detail = "Aceite final concedido com sucesso!",
                    Duration = 5000
                });
                await CarregarTcc();
            }
            else
            {
                var erro = await response.Content.ReadAsStringAsync();
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Erro",
                    Detail = erro,
                    Duration = 6000
                });
            }
        }
        finally { processandoAceite = false; }
    }

    // Issue #81 (D3/D12): veredito de aprovação de uma entrega. Sem corpo; após sucesso, recarrega
    // a tela (padrão já usado nas demais ações desta página).
    private async Task AprovarEntrega(Entrega entrega)
    {
        var confirmado = await DialogService.Confirm(
            "Tem certeza que deseja aprovar esta entrega?",
            "Aprovar entrega",
            new ConfirmOptions { OkButtonText = "Aprovar", CancelButtonText = "Cancelar" });

        if (confirmado != true) return;

        entregaIdProcessandoVeredito = entrega.Id;
        try
        {
            var response = await Http.PostAsync($"api/orientador/entregas/{entrega.Id}/aprovar", null);

            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Entrega aprovada",
                    Detail = "Entrega aprovada com sucesso!",
                    Duration = 4000
                });
                await CarregarTcc();
            }
            else
            {
                var erro = await response.Content.ReadAsStringAsync();
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Erro",
                    Detail = erro,
                    Duration = 6000
                });
            }
        }
        finally { entregaIdProcessandoVeredito = null; }
    }

    // Issue #81 (D3/D4/D12): veredito de rejeição — reusa RejeitarPropostaDialog (agora
    // parametrizável) pré-carregado com o Feedback atual da entrega, já que D4 define que rejeitar
    // sobrescreve o Feedback e o professor precisa ver o que está substituindo.
    private async Task AbrirRejeicaoEntrega(Entrega entrega)
    {
        var resultado = await DialogService.OpenAsync<RejeitarPropostaDialog>(
            "Rejeitar Entrega",
            new Dictionary<string, object?>
            {
                { "RotuloMotivo", "Parecer / Motivo da Rejeição" },
                { "TextoBotaoConfirmar", "Rejeitar Entrega" },
                { "MotivoInicial", entrega.Feedback }
            },
            new DialogOptions { Width = "500px" });

        if (resultado is not string motivo || string.IsNullOrWhiteSpace(motivo)) return;

        entregaIdProcessandoVeredito = entrega.Id;
        try
        {
            var payload = new RejeicaoDto { Motivo = motivo };
            var response = await Http.PostAsJsonAsync($"api/orientador/entregas/{entrega.Id}/rejeitar", payload);

            if (response.IsSuccessStatusCode)
            {
                var mensagem = await response.Content.ReadAsStringAsync();
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Entrega rejeitada",
                    Detail = mensagem,
                    Duration = 5000
                });
                await CarregarTcc();
            }
            else
            {
                var erro = await response.Content.ReadAsStringAsync();
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Erro",
                    Detail = erro,
                    Duration = 6000
                });
            }
        }
        finally { entregaIdProcessandoVeredito = null; }
    }

    // Issue #81 (D12): mesma paleta usada em Aluno/MeuTcc.razor (D13) para o veredito de
    // Entrega.Status — mantém as duas telas visualmente consistentes para o mesmo conceito.
    private static BadgeStyle BadgeStyleParaStatusEntrega(StatusEntrega status) => status switch
    {
        StatusEntrega.Aprovada => BadgeStyle.Success,
        StatusEntrega.Rejeitada => BadgeStyle.Danger,
        _ => BadgeStyle.Light
    };

    private static string TextoStatusEntrega(StatusEntrega status) => status switch
    {
        StatusEntrega.Aprovada => "Aprovada",
        StatusEntrega.Rejeitada => "Rejeitada",
        _ => "Aguardando Veredito"
    };
}
