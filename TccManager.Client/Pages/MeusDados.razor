@page "/meus-dados"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using TccManager.Shared.DTOs
@using TccManager.Client.Services
@attribute [Authorize]
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject ITokenRefreshCoordinator TokenRefreshCoordinator
@inject NotificationService NotificationService
@inject NavigationManager Navigation

<PageTitle>Meus Dados</PageTitle>

<RadzenStack Gap="1.5rem" style="max-width: 800px; margin: 0 auto;">
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
        <RadzenText TextStyle="TextStyle.H4" class="rz-my-0">Meus Dados</RadzenText>
        @if (usuario != null)
        {
            <RadzenBadge BadgeStyle="BadgeStyle.Secondary" Text="@usuario.Tipo.ToString()" />
        }
    </RadzenStack>

    @if (carregando)
    {
        <RadzenStack AlignItems="AlignItems.Center" Gap="1rem" class="rz-p-6">
            <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Mode="ProgressBarMode.Indeterminate" />
            <RadzenText TextStyle="TextStyle.Body2" class="rz-my-0">Carregando suas informações...</RadzenText>
        </RadzenStack>
    }
    else if (usuario != null)
    {
        <RadzenCard Variant="Variant.Filled" class="rz-shadow-2">
            <EditForm Model="editForm" OnValidSubmit="SalvarAlteracoes">
                <DataAnnotationsValidator />

                <RadzenStack Gap="1rem">
                    <RadzenRow Gap="1rem">
                        <RadzenColumn SizeMD="6" SizeXS="12">
                            <RadzenFormField Text="Nome Completo" Variant="Variant.Outlined" style="width: 100%;">
                                <RadzenTextBox Name="Nome" @bind-Value="editForm.Nome" style="width: 100%;" />
                            </RadzenFormField>
                            <ValidationMessage For="@(() => editForm.Nome)" />
                        </RadzenColumn>

                        <RadzenColumn SizeMD="6" SizeXS="12">
                            <RadzenFormField Text="E-mail" Variant="Variant.Outlined" style="width: 100%;">
                                <RadzenTextBox Name="Email" @bind-Value="editForm.Email" style="width: 100%;" />
                            </RadzenFormField>
                            <ValidationMessage For="@(() => editForm.Email)" />
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow Gap="1rem">
                        <RadzenColumn SizeMD="6" SizeXS="12">
                            <RadzenFormField Text="Tipo de Conta" Variant="Variant.Outlined" style="width: 100%;">
                                <RadzenTextBox Value="@usuario.Tipo.ToString()" Disabled="true" style="width: 100%;" />
                            </RadzenFormField>
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-my-0">Você não pode alterar seu próprio nível de acesso.</RadzenText>
                        </RadzenColumn>

                        <RadzenColumn SizeMD="6" SizeXS="12">
                            <RadzenFormField Text="Alterar Senha" Variant="Variant.Outlined" style="width: 100%;">
                                <RadzenPassword Name="Senha" @bind-Value="editForm.Senha" Placeholder="Deixe em branco para manter a atual" style="width: 100%;" />
                            </RadzenFormField>
                            <ValidationMessage For="@(() => editForm.Senha)" />
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow Gap="1rem">
                        <RadzenColumn SizeMD="6" SizeXS="12">
                            <RadzenFormField Text="Senha Atual" Variant="Variant.Outlined" style="width: 100%;">
                                <RadzenPassword Name="SenhaAtual" @bind-Value="editForm.SenhaAtual" Placeholder="Necessária para alterar e-mail ou senha" style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                        <RadzenButton ButtonType="ButtonType.Submit"
                                      Text="Salvar Alterações"
                                      Icon="save"
                                      IsBusy="salvando"
                                      BusyText="Salvando..."
                                      ButtonStyle="ButtonStyle.Primary" />
                    </RadzenStack>
                </RadzenStack>
            </EditForm>
        </RadzenCard>
    }
    else
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter">
            Não foi possível carregar os dados do perfil. Tente fazer login novamente.
        </RadzenAlert>
    }
</RadzenStack>

@code {
    // Issue #165 (achado A1/B3): a resposta de GET passou a ser UsuarioResponseDto (sem
    // Senha/SenhaAtual) — editForm é o modelo de escrita, separado do de leitura, inicializado
    // a partir de "usuario" a cada recarga.
    private UsuarioResponseDto? usuario;
    private UsuarioDto editForm = new();
    private bool carregando = true;
    private bool salvando = false;
    private int usuarioId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity == null || !user.Identity.IsAuthenticated)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            var idClaim = user.FindFirst(ClaimTypes.NameIdentifier);

            if (idClaim != null && int.TryParse(idClaim.Value, out int id))
            {
                usuarioId = id;
                await CarregarDados();
            }
            else
            {
                NotificationService.NotificarErro("Erro", "Erro: ID do usuário não encontrado no token.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro crítico: {ex.Message}");
        }
        finally
        {
            carregando = false;
        }
    }

    private async Task CarregarDados()
    {
        try
        {
            // Issue #158 (achado D12): AuthTokenHandler já anexa o Bearer em toda requisição
            // via DelegatingHandler (fonte única documentada) — setar
            // Http.DefaultRequestHeaders.Authorization aqui era redundante e, por Http ser um
            // HttpClient de escopo efetivamente singleton em Blazor WASM, podia manter um
            // token antigo sendo enviado após logout/troca de usuário na mesma aba.
            usuario = await Http.GetFromJsonAsync<UsuarioResponseDto>("api/usuario/me");
            if (usuario != null)
            {
                editForm = new UsuarioDto
                {
                    Nome = usuario.Nome,
                    Email = usuario.Email,
                    Tipo = usuario.Tipo,
                    Ativo = usuario.Ativo
                };
            }
        }
        catch (Exception)
        {
            NotificationService.NotificarErro("Falha ao carregar", "Falha ao comunicar com o servidor.");
        }
    }

    private async Task SalvarAlteracoes()
    {
        salvando = true;
        try
        {
            var response = await Http.PutAsJsonAsync($"api/usuario/{usuarioId}", editForm);

            if (response.IsSuccessStatusCode)
            {
                // Em vez de Navigation.NavigateTo(Uri, forceLoad: true) (comportamento antigo),
                // recarrega os dados do perfil in-place via GET api/usuario/me, para que o toast
                // de sucesso permaneça visível (um forceLoad imediato descartaria a notificação
                // antes do usuário conseguir vê-la) — decisão registrada na arquitetura (seção 7.2/11, P3).
                await CarregarDados();

                // Nome/e-mail exibidos no NavMenu vêm de claims presas no token já emitido —
                // força a renovação do par para que o token novo carregue os dados atuais do
                // banco, sem exigir logout/login (o refresh já recarrega a entidade do usuário).
                var tokenAtual = await LocalStorage.GetItemAsStringAsync("authToken");
                if (!string.IsNullOrWhiteSpace(tokenAtual))
                {
                    await TokenRefreshCoordinator.EnsureRefreshedAsync(tokenAtual.Replace("\"", string.Empty));
                }

                NotificationService.NotificarSucesso("Sucesso", "Dados atualizados com sucesso!");
            }
            else
            {
                var erro = await response.Content.ReadAsStringAsync();
                NotificationService.NotificarErro("Erro ao salvar", $"Erro ao salvar: {erro}");
            }
        }
        catch (Exception)
        {
            NotificationService.NotificarErro("Erro de conexão", "Erro de conexão ao tentar salvar.");
        }
        finally
        {
            salvando = false;
        }
    }
}
