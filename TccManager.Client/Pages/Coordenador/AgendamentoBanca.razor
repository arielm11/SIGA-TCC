@page "/coordenador/agendar-banca"
@using Microsoft.AspNetCore.Authorization
@using TccManager.Shared.DTOs
@using TccManager.Shared.Models
@attribute [Authorize(Roles = "Coordenador")]
@inject HttpClient Http
@inject NotificationService NotificationService

<PageTitle>Agendamento de Bancas</PageTitle>

<RadzenStack Gap="1.5rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
        <RadzenIcon Icon="event" />
        <RadzenText TextStyle="TextStyle.H4" class="rz-my-0">Agendamento de Bancas</RadzenText>
    </RadzenStack>

    @if (carregando)
    {
        <RadzenStack AlignItems="AlignItems.Center" Gap="1rem" class="rz-p-6">
            <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Mode="ProgressBarMode.Indeterminate" />
        </RadzenStack>
    }
    else
    {
        <RadzenRow Gap="1rem">
            <RadzenColumn SizeMD="5" SizeXS="12">
                <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">TCCs Aguardando Defesa</RadzenText>
                <RadzenListBox TValue="int" Data="@tccsProntos" ValueProperty="Id"
                                Value="@tccSelecionadoId" ValueChanged="@SelecionarTcc"
                                Multiple="false" AllowFiltering="false"
                                EmptyText="Nenhum TCC aguardando defesa no momento."
                                style="width: 100%; height: 420px;">
                    <Template Context="item">
                        @{ var tcc = (TccAguardandoBancaDto)item; }
                        <div>
                            <div style="font-weight: 600;">@tcc.NomeAluno</div>
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-my-0">@tcc.Titulo</RadzenText>
                        </div>
                    </Template>
                </RadzenListBox>
            </RadzenColumn>

            <RadzenColumn SizeMD="7" SizeXS="12">
                <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">Dados do Agendamento</RadzenText>
                @if (tccSelecionadoId > 0)
                {
                    <RadzenCard Variant="Variant.Outlined" class="rz-shadow-2">
                        <EditForm Model="agendamento" OnValidSubmit="GravarBanca">
                            <DataAnnotationsValidator />
                            <RadzenStack Gap="1rem">
                                <RadzenRow Gap="1rem">
                                    <RadzenColumn SizeMD="6" SizeXS="12">
                                        <RadzenFormField Text="Data e Hora" Variant="Variant.Outlined" style="width: 100%;">
                                            <RadzenDatePicker TValue="DateTime" @bind-Value="agendamento.DataHora" ShowTime="true"
                                                              DateFormat="dd/MM/yyyy HH:mm" style="width: 100%;" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                    <RadzenColumn SizeMD="6" SizeXS="12">
                                        <RadzenFormField Text="Local / Link Teams" Variant="Variant.Outlined" style="width: 100%;">
                                            <RadzenTextBox @bind-Value="agendamento.Local" Placeholder="Sala ou URL" style="width: 100%;" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                </RadzenRow>

                                <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-0">Composição da Banca (RN05)</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body2" class="rz-my-0">
                                    Selecione pelo menos 2 membros. O Orientador (<strong>@orientadorNome</strong>) já faz parte automaticamente.
                                </RadzenText>

                                <RadzenRow Gap="1rem">
                                    <RadzenColumn SizeMD="6" SizeXS="12">
                                        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-primary rz-mb-1">Professores Internos</RadzenText>
                                        <div style="max-height: 200px; overflow-y: auto;" class="rz-border-base-200 rz-border-radius-2 rz-p-2">
                                            <RadzenCheckBoxList TValue="int" Data="@todosProfessores" TextProperty="Nome" ValueProperty="Id"
                                                                Value="@professoresSelecionados"
                                                                Change="@((IEnumerable<int> v) => professoresSelecionados = v)"
                                                                Orientation="Orientation.Vertical" />
                                        </div>
                                    </RadzenColumn>
                                    <RadzenColumn SizeMD="6" SizeXS="12">
                                        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-success rz-mb-1">Membros Externos</RadzenText>
                                        <div style="max-height: 200px; overflow-y: auto;" class="rz-border-base-200 rz-border-radius-2 rz-p-2">
                                            <RadzenCheckBoxList TValue="int" Data="@externosOpcoes" TextProperty="Display" ValueProperty="Id"
                                                                Value="@externosSelecionados"
                                                                Change="@((IEnumerable<int> v) => externosSelecionados = v)"
                                                                Orientation="Orientation.Vertical" />
                                        </div>
                                    </RadzenColumn>
                                </RadzenRow>

                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                                    <RadzenButton ButtonType="ButtonType.Submit" Text="Confirmar Agendamento" Icon="event_available"
                                                  ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Large"
                                                  Disabled="@(TotalMembrosSelecionados < 2)" />
                                </RadzenStack>
                            </RadzenStack>
                        </EditForm>
                    </RadzenCard>
                }
                else
                {
                    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" ShowIcon="true">
                        Selecione um aluno na lista à esquerda para agendar a banca.
                    </RadzenAlert>
                }
            </RadzenColumn>
        </RadzenRow>
    }
</RadzenStack>

@code {
    private bool carregando = true;
    private List<TccAguardandoBancaDto> tccsProntos = new();
    private List<ProfessorResumoDto> todosProfessores = new();
    private List<MembroExternoDto> todosExternos = new();
    private List<MembroExternoOpcao> externosOpcoes = new();

    private int tccSelecionadoId = 0;
    private string orientadorNome = "";
    private AgendarBancaDto agendamento = new();

    private IEnumerable<int> professoresSelecionados = new List<int>();
    private IEnumerable<int> externosSelecionados = new List<int>();

    private int TotalMembrosSelecionados => (professoresSelecionados?.Count() ?? 0) + (externosSelecionados?.Count() ?? 0);

    protected override async Task OnInitializedAsync()
    {
        await CarregarListas();
    }

    private async Task CarregarListas()
    {
        carregando = true;
        try
        {
            tccsProntos = await Http.GetFromJsonAsync<List<TccAguardandoBancaDto>>("api/coordenador/aguardando-banca") ?? new();

            var professoresPaginado = await Http.GetFromJsonAsync<PagedResult<ProfessorResumoDto>>($"api/coordenador/professores?pageSize={PaginacaoQuery.MaxPageSize}");
            todosProfessores = professoresPaginado?.Items ?? new();

            var externosPaginado = await Http.GetFromJsonAsync<PagedResult<MembroExternoDto>>($"api/coordenador/membros-externos?pageSize={PaginacaoQuery.MaxPageSize}");
            todosExternos = externosPaginado?.Items ?? new();
            externosOpcoes = todosExternos.Select(e => new MembroExternoOpcao
            {
                Id = e.Id,
                Display = $"{e.Nome} ({e.Instituicao})"
            }).ToList();
        }
        finally { carregando = false; }
    }

    private void SelecionarTcc(int id)
    {
        tccSelecionadoId = id;
        orientadorNome = tccsProntos.FirstOrDefault(t => t.Id == id)?.NomeOrientador ?? "";
        agendamento = new AgendarBancaDto();
        professoresSelecionados = new List<int>();
        externosSelecionados = new List<int>();
    }

    private async Task GravarBanca()
    {
        agendamento.ProfessoresIds = professoresSelecionados?.ToList() ?? new();
        agendamento.MembrosExternosIds = externosSelecionados?.ToList() ?? new();

        var resp = await Http.PostAsJsonAsync($"api/coordenador/tcc/{tccSelecionadoId}/banca", agendamento);
        if (resp.IsSuccessStatusCode)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Banca agendada",
                Detail = "Banca agendada com sucesso!",
                Duration = 5000
            });
            tccSelecionadoId = 0;
            await CarregarListas();
        }
        else
        {
            var erro = await resp.Content.ReadAsStringAsync();
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Erro ao agendar",
                Detail = erro,
                Duration = 6000
            });
        }
    }

    private class MembroExternoOpcao
    {
        public int Id { get; set; }
        public string Display { get; set; } = string.Empty;
    }
}
