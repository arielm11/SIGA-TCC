@page "/coordenador/professores"
@using Microsoft.AspNetCore.Authorization
@using TccManager.Shared.DTOs
@using TccManager.Shared.Models
@attribute [Authorize(Roles = "Coordenador")]
@inject HttpClient Http
@inject DialogService DialogService
@inject NotificationService NotificationService

<PageTitle>Gestão de Professores</PageTitle>

<RadzenStack Gap="1.5rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
        <RadzenIcon Icon="group" />
        <RadzenText TextStyle="TextStyle.H4" class="rz-my-0">Gestão do Corpo Docente e Avaliadores</RadzenText>
    </RadzenStack>

    <RadzenTabs RenderMode="TabRenderMode.Client">
        <Tabs>
            <RadzenTabsItem Text="Professores Internos (Orientadores)" Icon="badge">
                <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-3">
                    Gerencie a carga de orientandos de cada professor. Professores marcados como indisponíveis não aparecerão na lista de designação.
                </RadzenText>

                <RadzenDataGrid @ref="gridProfessores" TItem="ProfessorResumoDto" Data="@professores" Count="@countProfessores"
                                LoadData="@LoadDataProfessores" AllowPaging="true" PageSize="20"
                                EmptyText="Nenhum professor cadastrado." PageSizeText="Itens por página">
                    <Columns>
                        <RadzenDataGridColumn TItem="ProfessorResumoDto" Property="Nome" Title="Nome do Professor" />
                        <RadzenDataGridColumn TItem="ProfessorResumoDto" Title="Carga Atual" Sortable="false" Width="140px" TextAlign="TextAlign.Center">
                            <Template Context="prof">
                                <RadzenBadge BadgeStyle="@(prof.CargaAtual >= prof.LimiteOrientandos ? BadgeStyle.Danger : BadgeStyle.Primary)"
                                             Text="@($"{prof.CargaAtual} / {prof.LimiteOrientandos}")" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ProfessorResumoDto" Title="Limite de Alunos" Sortable="false" Width="160px" TextAlign="TextAlign.Center">
                            <Template Context="prof">
                                <RadzenNumeric TValue="int" @bind-Value="prof.LimiteOrientandos" Min="1" Max="20" style="width: 100px;" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ProfessorResumoDto" Title="Status" Sortable="false" Width="120px" TextAlign="TextAlign.Center">
                            <Template Context="prof">
                                <RadzenSwitch @bind-Value="prof.AceitandoOrientandos" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ProfessorResumoDto" Title="Ações" Sortable="false" Filterable="false" Width="130px" TextAlign="TextAlign.Center">
                            <Template Context="prof">
                                <RadzenButton Text="Salvar" Icon="save" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                                              Click="@(() => SalvarCapacidade(prof))" />
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </RadzenTabsItem>

            <RadzenTabsItem Text="Avaliadores Externos (Banca)" Icon="groups">
                <RadzenRow Gap="1rem">
                    <RadzenColumn SizeMD="4" SizeXS="12">
                        <RadzenCard Variant="Variant.Outlined" class="rz-shadow-2">
                            <RadzenText TextStyle="TextStyle.H6" class="rz-my-0">Novo Avaliador Externo</RadzenText>
                            <EditForm Model="novoExterno" OnValidSubmit="SalvarMembroExterno">
                                <DataAnnotationsValidator />
                                <RadzenStack Gap="1rem" class="rz-mt-3">
                                    <div>
                                        <RadzenFormField Text="Nome Completo" Variant="Variant.Outlined" style="width: 100%;">
                                            <RadzenTextBox Name="Nome" @bind-Value="novoExterno.Nome" style="width: 100%;" />
                                        </RadzenFormField>
                                        <ValidationMessage For="@(() => novoExterno.Nome)" />
                                    </div>
                                    <div>
                                        <RadzenFormField Text="E-mail" Variant="Variant.Outlined" style="width: 100%;">
                                            <RadzenTextBox Name="Email" @bind-Value="novoExterno.Email" style="width: 100%;" />
                                        </RadzenFormField>
                                        <ValidationMessage For="@(() => novoExterno.Email)" />
                                    </div>
                                    <div>
                                        <RadzenFormField Text="Instituição / Empresa" Variant="Variant.Outlined" style="width: 100%;">
                                            <RadzenTextBox Name="Instituicao" @bind-Value="novoExterno.Instituicao" style="width: 100%;" />
                                        </RadzenFormField>
                                        <ValidationMessage For="@(() => novoExterno.Instituicao)" />
                                    </div>
                                    <RadzenButton ButtonType="ButtonType.Submit" Text="Adicionar Avaliador" Icon="add_circle"
                                                  ButtonStyle="ButtonStyle.Primary" style="width: 100%;" />
                                </RadzenStack>
                            </EditForm>
                        </RadzenCard>
                    </RadzenColumn>

                    <RadzenColumn SizeMD="8" SizeXS="12">
                        <RadzenDataGrid @ref="gridExternos" TItem="MembroExternoDto" Data="@externos" Count="@countExternos"
                                        LoadData="@LoadDataExternos" AllowPaging="true" PageSize="20"
                                        EmptyText="Nenhum avaliador externo cadastrado." PageSizeText="Itens por página">
                            <Columns>
                                <RadzenDataGridColumn TItem="MembroExternoDto" Property="Nome" Title="Nome" />
                                <RadzenDataGridColumn TItem="MembroExternoDto" Property="Instituicao" Title="Instituição" />
                                <RadzenDataGridColumn TItem="MembroExternoDto" Property="Email" Title="E-mail" />
                                <RadzenDataGridColumn TItem="MembroExternoDto" Title="Ações" Sortable="false" Filterable="false" Width="130px" TextAlign="TextAlign.Center">
                                    <Template Context="membro">
                                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Size="ButtonSize.Small"
                                                      Click="@(() => AbrirModalEdicao(membro))" class="rz-me-1" title="Editar" />
                                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Size="ButtonSize.Small"
                                                      Click="@(() => ExcluirMembroExterno(membro.Id))" title="Excluir" />
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
</RadzenStack>

@code {
    private RadzenDataGrid<ProfessorResumoDto>? gridProfessores;
    private RadzenDataGrid<MembroExternoDto>? gridExternos;

    private List<ProfessorResumoDto> professores = new();
    private int countProfessores;

    private List<MembroExternoDto> externos = new();
    private int countExternos;

    private MembroExterno novoExterno = new();
    private bool professoresCarregados;
    private bool externosCarregados;

    // RadzenDataGrid (nesta versão do Radzen.Blazor) não dispara LoadData automaticamente no
    // primeiro render — precisa de Reload() explícito. Com RadzenTabs RenderMode="TabRenderMode.Server",
    // o conteúdo de uma aba só é montado (e a referência @ref só deixa de ser null) quando ela
    // é selecionada, então cada grid é carregada assim que sua referência aparecer disponível,
    // verificado a cada OnAfterRenderAsync (não só no primeiro), não por um evento de troca de aba
    // (cuja ordem de disparo relativa à montagem do conteúdo não é garantida).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!professoresCarregados && gridProfessores != null)
        {
            professoresCarregados = true;
            await gridProfessores.Reload();
        }

        if (!externosCarregados && gridExternos != null)
        {
            externosCarregados = true;
            await gridExternos.Reload();
        }
    }

    private async Task LoadDataProfessores(LoadDataArgs args)
    {
        var pageSize = args.Top ?? PaginacaoQuery.DefaultPageSize;
        var page = (args.Skip ?? 0) / pageSize + 1;

        var resultado = await Http.GetFromJsonAsync<PagedResult<ProfessorResumoDto>>($"api/coordenador/professores?page={page}&pageSize={pageSize}");
        professores = resultado?.Items ?? new();
        countProfessores = resultado?.TotalCount ?? 0;
    }

    private async Task LoadDataExternos(LoadDataArgs args)
    {
        var pageSize = args.Top ?? PaginacaoQuery.DefaultPageSize;
        var page = (args.Skip ?? 0) / pageSize + 1;

        var resultado = await Http.GetFromJsonAsync<PagedResult<MembroExternoDto>>($"api/coordenador/membros-externos?page={page}&pageSize={pageSize}");
        externos = resultado?.Items ?? new();
        countExternos = resultado?.TotalCount ?? 0;
    }

    private async Task SalvarCapacidade(ProfessorResumoDto prof)
    {
        var payload = new CapacidadeProfessorDto
        {
            LimiteOrientandos = prof.LimiteOrientandos,
            AceitandoOrientandos = prof.AceitandoOrientandos
        };

        var response = await Http.PutAsJsonAsync($"api/coordenador/professores/{prof.Id}/capacidade", payload);
        if (response.IsSuccessStatusCode)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Capacidade salva",
                Detail = "Capacidade salva com sucesso!",
                Duration = 4000
            });
        }
        else
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Erro",
                Detail = "Erro ao salvar capacidade.",
                Duration = 5000
            });
        }
    }

    private async Task SalvarMembroExterno()
    {
        var response = await Http.PostAsJsonAsync("api/coordenador/membros-externos", novoExterno);
        if (response.IsSuccessStatusCode)
        {
            novoExterno = new();
            if (gridExternos != null)
            {
                await gridExternos.Reload();
            }
        }
        else
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Erro",
                Detail = "Erro ao adicionar avaliador externo.",
                Duration = 5000
            });
        }
    }

    private async Task ExcluirMembroExterno(int id)
    {
        var confirmado = await DialogService.Confirm(
            "Deseja excluir este avaliador externo?",
            "Excluir avaliador externo",
            new ConfirmOptions { OkButtonText = "Excluir", CancelButtonText = "Cancelar" });

        if (confirmado == true)
        {
            var response = await Http.DeleteAsync($"api/coordenador/membros-externos/{id}");
            if (response.IsSuccessStatusCode && gridExternos != null)
            {
                await gridExternos.Reload();
            }
        }
    }

    // --- MODAL DE EDIÇÃO (DialogService.OpenAsync) ---

    private async Task AbrirModalEdicao(MembroExternoDto membro)
    {
        var resultado = await DialogService.OpenAsync<EditarMembroExternoDialog>(
            "Editar Avaliador Externo",
            new Dictionary<string, object?> { { "Membro", membro } },
            new DialogOptions { Width = "500px" });

        if (resultado is true && gridExternos != null)
        {
            await gridExternos.Reload();
        }
    }
}
