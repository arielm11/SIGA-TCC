@page "/coordenador/bancas-concluidas"
@using Microsoft.AspNetCore.Authorization
@using TccManager.Shared.DTOs
@attribute [Authorize(Roles = "Coordenador")]
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject NotificationService NotificationService

<PageTitle>Bancas Concluídas</PageTitle>

<RadzenStack Gap="1.5rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
        <RadzenIcon Icon="fact_check" />
        <RadzenText TextStyle="TextStyle.H4" class="rz-my-0">Bancas Concluídas</RadzenText>
    </RadzenStack>

    <RadzenDataGrid @ref="grid" Data="@bancas" Count="@count" LoadData="@LoadData" TItem="BancaConcluidaDto"
                    AllowPaging="true" PageSize="@PaginacaoQuery.DefaultPageSize"
                    EmptyText="Nenhuma banca concluída até o momento." PageSizeText="Itens por página">
        <Columns>
            <RadzenDataGridColumn TItem="BancaConcluidaDto" Property="NomeAluno" Title="Aluno" />
            <RadzenDataGridColumn TItem="BancaConcluidaDto" Property="TccTitulo" Title="Título do TCC" />
            <RadzenDataGridColumn TItem="BancaConcluidaDto" Property="DataHora" Title="Data da Banca" Width="180px">
                <Template Context="banca">
                    @banca.DataHora.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="BancaConcluidaDto" Property="NotaFinal" Title="Nota" Width="100px">
                <Template Context="banca">
                    @banca.NotaFinal.ToString("0.0")
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="BancaConcluidaDto" Title="Status" Width="130px">
                <Template Context="banca">
                    <RadzenBadge BadgeStyle="@(banca.Aprovado ? BadgeStyle.Success : BadgeStyle.Danger)"
                                 Text="@(banca.Aprovado ? "Aprovado" : "Reprovado")" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="BancaConcluidaDto" Title="Ação" Sortable="false" Filterable="false" Width="160px" TextAlign="TextAlign.End">
                <Template Context="banca">
                    <RadzenButton Text="Baixar PDF" Icon="picture_as_pdf" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Size="ButtonSize.Small"
                                  IsBusy="@(bancaIdBaixando == banca.BancaId)" BusyText="Baixando..."
                                  Disabled="@(bancaIdBaixando == banca.BancaId)"
                                  Click="@(() => BaixarAtaPdf(banca.BancaId))" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</RadzenStack>

@code {
    private RadzenDataGrid<BancaConcluidaDto>? grid;
    private List<BancaConcluidaDto> bancas = new();
    private int count;
    private int? bancaIdBaixando;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && grid != null)
        {
            await grid.Reload();
        }
    }

    private async Task LoadData(LoadDataArgs args)
    {
        var pageSize = args.Top ?? PaginacaoQuery.DefaultPageSize;
        var page = (args.Skip ?? 0) / pageSize + 1;

        var resultado = await Http.GetFromJsonAsync<PagedResult<BancaConcluidaDto>>(
            $"api/coordenador/bancas-concluidas?page={page}&pageSize={pageSize}");

        bancas = resultado?.Items ?? new();
        count = resultado?.TotalCount ?? 0;
    }

    private async Task BaixarAtaPdf(int bancaId)
    {
        bancaIdBaixando = bancaId;
        try
        {
            var response = await Http.GetAsync($"api/coordenador/banca/{bancaId}/ata-pdf");

            if (response.IsSuccessStatusCode)
            {
                var bytes = await response.Content.ReadAsByteArrayAsync();
                var base64 = Convert.ToBase64String(bytes);
                await JSRuntime.InvokeVoidAsync("downloadFileFromBytes", $"ata-defesa-{bancaId}.pdf", "application/pdf", base64);
            }
            else
            {
                var erro = await response.Content.ReadAsStringAsync();
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Erro",
                    Detail = $"Erro ao baixar a ata: {erro}",
                    Duration = 6000
                });
            }
        }
        finally { bancaIdBaixando = null; }
    }
}
