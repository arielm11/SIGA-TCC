@page "/coordenador/registrar-resultado"
@using Microsoft.AspNetCore.Authorization
@using TccManager.Shared.DTOs
@attribute [Authorize(Roles = "Coordenador")]
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject DialogService DialogService
@inject NotificationService NotificationService

<PageTitle>Lançamento de Nota Final e Ata</PageTitle>

<RadzenStack Gap="1.5rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
        <RadzenIcon Icon="workspace_premium" />
        <RadzenText TextStyle="TextStyle.H4" class="rz-my-0">Lançamento de Nota Final e Ata</RadzenText>
    </RadzenStack>

    @if (carregando)
    {
        <RadzenStack AlignItems="AlignItems.Center" Gap="1rem" class="rz-p-6">
            <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Mode="ProgressBarMode.Indeterminate" />
        </RadzenStack>
    }
    else if (!bancasPendentes.Any())
    {
        <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" ShowIcon="true">
            Não há nenhuma banca aguardando lançamento de nota no momento.
        </RadzenAlert>
    }
    else
    {
        <RadzenDataGrid Data="@bancasPendentes" TItem="BancaPendenteDto" AllowPaging="true" PageSize="10"
                        PageSizeOptions="@(new[] { 10, 20, 50 })" AllowSorting="true" PageSizeText="Itens por página">
            <Columns>
                <RadzenDataGridColumn TItem="BancaPendenteDto" Property="NomeAluno" Title="Aluno" />
                <RadzenDataGridColumn TItem="BancaPendenteDto" Property="TccTitulo" Title="Título do TCC" />
                <RadzenDataGridColumn TItem="BancaPendenteDto" Property="DataHora" Title="Data da Banca" Width="180px">
                    <Template Context="banca">
                        @banca.DataHora.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="BancaPendenteDto" Title="Ação" Sortable="false" Filterable="false" Width="440px" TextAlign="TextAlign.End">
                    <Template Context="banca">
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" AlignItems="AlignItems.Center"
                                     Wrap="FlexWrap.Wrap" style="width: 100%;">
                            <RadzenButton Text="Rascunho" Icon="description" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" Size="ButtonSize.Small"
                                          IsBusy="@(bancaIdBaixandoRascunho == banca.TccId)" BusyText="Baixando..."
                                          Disabled="@(bancaIdBaixandoRascunho == banca.TccId)"
                                          Click="@(() => BaixarAtaRascunho(banca.TccId))" />

                            @if (banca.MembrosExternos.Any())
                            {
                                <RadzenSplitButton Text="Reenviar Rascunho" Icon="forward_to_inbox" ButtonStyle="ButtonStyle.Warning"
                                                    Variant="Variant.Outlined" Size="ButtonSize.Small" AlwaysOpenPopup="true"
                                                    Click="@(args => ReenviarRascunho(banca.TccId, args))">
                                    @foreach (var membro in banca.MembrosExternos)
                                    {
                                        <RadzenSplitButtonItem Text="@membro.Nome" Value="@membro.MembroExternoId.ToString()"
                                                               Disabled="@(membroExternoIdReenviando == membro.MembroExternoId)" />
                                    }
                                </RadzenSplitButton>
                            }

                            <RadzenButton Text="Registrar Resultado" Icon="upload_file" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                          Click="@(() => AbrirModal(banca.TccId, banca.NomeAluno))" />
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</RadzenStack>

@code {
    private bool carregando = true;
    private List<BancaPendenteDto> bancasPendentes = new();

    private int? bancaIdBaixandoRascunho;
    private int? membroExternoIdReenviando;

    protected override async Task OnInitializedAsync()
    {
        await CarregarListas();
    }

    private async Task CarregarListas()
    {
        carregando = true;
        try
        {
            bancasPendentes = await Http.GetFromJsonAsync<List<BancaPendenteDto>>("api/coordenador/bancas-pendentes-resultado") ?? new();
        }
        catch
        {
            // Issue #75: sem este catch, uma falha de HTTP (rede, 401, 500) propagava como
            // exceção não tratada a partir de OnInitializedAsync, derrubando a renderização
            // inteira da página em vez de mostrar um erro — mesmo padrão usado em
            // Dashboard.CarregarDados e ConvitesBanca.CarregarConvites, que já tratavam isso.
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Erro de conexão",
                Detail = "Erro de conexão ao buscar as bancas pendentes de resultado.",
                Duration = 5000
            });
        }
        finally { carregando = false; }
    }

    private async Task AbrirModal(int bancaId, string nomeAluno)
    {
        var resultado = await DialogService.OpenAsync<RegistrarResultadoDialog>(
            $"Registrar Resultado: {nomeAluno}",
            new Dictionary<string, object?> { { "BancaId", bancaId }, { "NomeAluno", nomeAluno } },
            new DialogOptions { Width = "500px", CloseDialogOnOverlayClick = false });

        if (resultado is true)
        {
            await CarregarListas();
        }
    }

    private async Task BaixarAtaRascunho(int bancaId)
    {
        bancaIdBaixandoRascunho = bancaId;
        try
        {
            var response = await Http.GetAsync($"api/coordenador/banca/{bancaId}/ata-rascunho-pdf");

            if (response.IsSuccessStatusCode)
            {
                var bytes = await response.Content.ReadAsByteArrayAsync();
                var base64 = Convert.ToBase64String(bytes);
                await JSRuntime.InvokeVoidAsync("downloadFileFromBytes", $"ata-rascunho-{bancaId}.pdf", "application/pdf", base64);
            }
            else
            {
                var erro = await response.Content.ReadAsStringAsync();
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Erro",
                    Detail = $"Erro ao baixar o rascunho da ata: {erro}",
                    Duration = 6000
                });
            }
        }
        finally { bancaIdBaixandoRascunho = null; }
    }

    private async Task ReenviarRascunho(int bancaId, RadzenSplitButtonItem item)
    {
        if (!int.TryParse(item.Value, out var membroExternoId)) return;

        var nomeMembro = item.Text;
        membroExternoIdReenviando = membroExternoId;
        try
        {
            var response = await Http.PostAsync($"api/coordenador/banca/{bancaId}/membro-externo/{membroExternoId}/reenviar-rascunho", null);

            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Rascunho reenviado",
                    Detail = $"Novo link de acesso ao rascunho enviado para {nomeMembro}.",
                    Duration = 5000
                });
            }
            else
            {
                var erro = await response.Content.ReadAsStringAsync();
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Erro",
                    Detail = $"Erro ao reenviar o rascunho: {erro}",
                    Duration = 6000
                });
            }
        }
        finally { membroExternoIdReenviando = null; }
    }
}
