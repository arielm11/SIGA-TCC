@page "/coordenador/dashboard"
@using Microsoft.AspNetCore.Authorization
@using TccManager.Shared.DTOs
@attribute [Authorize(Roles = "Coordenador")]
@inject HttpClient Http
@inject NotificationService NotificationService

<PageTitle>Painel da Coordenação</PageTitle>

<RadzenStack Gap="1.5rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
        <RadzenIcon Icon="dashboard" />
        <RadzenText TextStyle="TextStyle.H4" class="rz-my-0">Painel da Coordenação</RadzenText>
    </RadzenStack>

    @if (carregando)
    {
        <RadzenStack AlignItems="AlignItems.Center" Gap="1rem" class="rz-p-6">
            <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Mode="ProgressBarMode.Indeterminate" />
            <RadzenText TextStyle="TextStyle.Body2" class="rz-my-0">Calculando estatísticas...</RadzenText>
        </RadzenStack>
    }
    else
    {
        @if (stats != null)
        {
            <RadzenRow Gap="1rem">
                <RadzenColumn SizeMD="3" SizeSM="6" SizeXS="12">
                    <RadzenCard Variant="Variant.Filled" class="rz-shadow-2 rz-text-align-center">
                        <RadzenIcon Icon="assignment" IconColor="var(--rz-primary)" style="font-size: 2rem;" />
                        <RadzenText TextStyle="TextStyle.H3" class="rz-my-0">@stats.TotalAtivos</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2" class="rz-my-0">TCCs Ativos</RadzenText>
                    </RadzenCard>
                </RadzenColumn>
                <RadzenColumn SizeMD="3" SizeSM="6" SizeXS="12">
                    <RadzenCard Variant="Variant.Filled" class="rz-shadow-2 rz-text-align-center">
                        <RadzenIcon Icon="inbox" IconColor="var(--rz-warning)" style="font-size: 2rem;" />
                        <RadzenText TextStyle="TextStyle.H3" class="rz-my-0">@stats.PropostasPendentes</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2" class="rz-my-0">Propostas Pendentes</RadzenText>
                    </RadzenCard>
                </RadzenColumn>
                <RadzenColumn SizeMD="3" SizeSM="6" SizeXS="12">
                    <RadzenCard Variant="Variant.Filled" class="rz-shadow-2 rz-text-align-center">
                        <RadzenIcon Icon="event" IconColor="var(--rz-info)" style="font-size: 2rem;" />
                        <RadzenText TextStyle="TextStyle.H3" class="rz-my-0">@stats.AguardandoBanca</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2" class="rz-my-0">Aguardando Banca</RadzenText>
                    </RadzenCard>
                </RadzenColumn>
                <RadzenColumn SizeMD="3" SizeSM="6" SizeXS="12">
                    <RadzenCard Variant="Variant.Filled" class="rz-shadow-2 rz-text-align-center">
                        <RadzenIcon Icon="check_circle" IconColor="var(--rz-success)" style="font-size: 2rem;" />
                        <RadzenText TextStyle="TextStyle.H3" class="rz-my-0">@stats.TccsConcluidos</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2" class="rz-my-0">Concluídos</RadzenText>
                    </RadzenCard>
                </RadzenColumn>
            </RadzenRow>
        }

        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenIcon Icon="move_to_inbox" />
            <RadzenText TextStyle="TextStyle.H6" class="rz-my-0">Atribuir Orientadores</RadzenText>
        </RadzenStack>

        <RadzenDataGrid Data="@pendentes" TItem="TccResumoDto"
                        AllowPaging="true" PageSize="10" PageSizeOptions="@(new[] { 10, 20, 50 })"
                        AllowSorting="true"
                        EmptyText="Não há novas propostas pendentes no momento."
                        PageSizeText="Itens por página">
            <Columns>
                <RadzenDataGridColumn TItem="TccResumoDto" Property="NomeAluno" Title="Aluno" />
                <RadzenDataGridColumn TItem="TccResumoDto" Property="Titulo" Title="Título da Proposta" />
                <RadzenDataGridColumn TItem="TccResumoDto" Property="DataCriacao" Title="Data de Submissão" Width="180px">
                    <Template Context="tcc">
                        @tcc.DataCriacao.ToLocalTime().ToString("dd/MM/yyyy")
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TccResumoDto" Title="Ação" Sortable="false" Filterable="false" Width="160px">
                    <Template Context="tcc">
                        <RadzenButton Text="Designar" Icon="person_add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                      Click="@(() => AbrirDesignacao(tcc))" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>

        @if (tccSelecionado != null)
        {
            <RadzenCard Variant="Variant.Outlined" class="rz-shadow-2">
                <RadzenText TextStyle="TextStyle.H6" class="rz-my-0">Designar Orientador para: @tccSelecionado.NomeAluno</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-2">
                    Selecione um professor da lista abaixo. O sistema mostra a carga atual de orientandos de cada um para ajudar na distribuição.
                </RadzenText>

                <RadzenRow AlignItems="AlignItems.Center" Gap="1rem" class="rz-mt-3">
                    <RadzenColumn SizeMD="8" SizeXS="12">
                        <RadzenDropDown TValue="int" Data="@professoresOptions" TextProperty="Display" ValueProperty="Id"
                                        @bind-Value="professorSelecionadoId" Placeholder="-- Selecione o Professor --"
                                        style="width: 100%;" />
                    </RadzenColumn>
                    <RadzenColumn SizeMD="4" SizeXS="12">
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                            <RadzenButton Text="Cancelar" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Click="@FecharDesignacao" />
                            <RadzenButton Text="Confirmar" ButtonStyle="ButtonStyle.Success"
                                          Disabled="@(professorSelecionadoId == 0 || enviando)"
                                          IsBusy="enviando" BusyText="Salvando..."
                                          Click="@SalvarDesignacao" />
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenCard>
        }
    }
</RadzenStack>

@code {
    private bool carregando = true;
    private bool enviando = false;

    private DashboardCoordenadorDto? stats;
    private List<TccResumoDto>? pendentes;
    private List<ProfessorResumoDto>? professores;
    private List<ProfessorOpcao> professoresOptions = new();

    private TccResumoDto? tccSelecionado;
    private int professorSelecionadoId = 0;

    protected override async Task OnInitializedAsync()
    {
        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        carregando = true;
        try
        {
            stats = await Http.GetFromJsonAsync<DashboardCoordenadorDto>("api/coordenador/dashboard-stats");
            pendentes = await Http.GetFromJsonAsync<List<TccResumoDto>>("api/coordenador/propostas-pendentes");
            var professoresPaginado = await Http.GetFromJsonAsync<PagedResult<ProfessorResumoDto>>($"api/coordenador/professores?pageSize={PaginacaoQuery.MaxPageSize}");
            professores = professoresPaginado?.Items;
            professoresOptions = (professores ?? new()).Select(p => new ProfessorOpcao
            {
                Id = p.Id,
                Display = $"{p.Nome} (Carga: {p.CargaAtual} orientandos)"
            }).ToList();
        }
        catch
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Erro",
                Detail = "Erro ao carregar dados do painel.",
                Duration = 5000
            });
        }
        finally { carregando = false; }
    }

    private void AbrirDesignacao(TccResumoDto tcc)
    {
        tccSelecionado = tcc;
        professorSelecionadoId = 0;
    }

    private void FecharDesignacao()
    {
        tccSelecionado = null;
        professorSelecionadoId = 0;
    }

    private async Task SalvarDesignacao()
    {
        if (tccSelecionado == null || professorSelecionadoId == 0) return;

        enviando = true;
        try
        {
            var payload = new DesignarOrientadorDto { OrientadorId = professorSelecionadoId };
            var response = await Http.PutAsJsonAsync($"api/coordenador/propostas/{tccSelecionado.Id}/designar-orientador", payload);

            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Orientador designado",
                    Detail = "Orientador designado! A proposta foi aprovada e o aluno será notificado.",
                    Duration = 5000
                });
                FecharDesignacao();
                await CarregarDados(); // Recarrega KPIs e a lista
            }
            else
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Erro",
                    Detail = "Erro ao designar orientador.",
                    Duration = 5000
                });
            }
        }
        finally { enviando = false; }
    }

    private class ProfessorOpcao
    {
        public int Id { get; set; }
        public string Display { get; set; } = string.Empty;
    }
}
