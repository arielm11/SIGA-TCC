@page "/usuarios"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using TccManager.Shared.DTOs
@using TccManager.Shared.Enums
@attribute [Authorize(Roles = "Admin")]
@inject AuthenticationStateProvider AuthStateProvider
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject HttpClient Http
@inject NavigationManager Navigation
@inject DialogService DialogService
@inject NotificationService NotificationService

<PageTitle>Usuários</PageTitle>

<RadzenStack Gap="1.5rem">
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
        <RadzenText TextStyle="TextStyle.H4" class="rz-my-0">Gerenciar Usuários</RadzenText>
        <RadzenButton Text="Novo Usuário" Icon="add" ButtonStyle="ButtonStyle.Primary" Click="@IrParaNovoUsuario" />
    </RadzenStack>

    @if (usuarios == null)
    {
        <RadzenStack AlignItems="AlignItems.Center" Gap="1rem" class="rz-p-6">
            <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Mode="ProgressBarMode.Indeterminate" />
            <RadzenText TextStyle="TextStyle.Body2" class="rz-my-0">Buscando usuários...</RadzenText>
        </RadzenStack>
    }
    else
    {
        <RadzenDataGrid Data="@usuarios" TItem="UsuarioDto"
                        AllowPaging="true" PageSize="10" PageSizeOptions="@(new[] { 10, 20, 50 })"
                        AllowSorting="true"
                        EmptyText="Nenhum usuário encontrado além de você."
                        PageSizeText="Itens por página">
            <Columns>
                <RadzenDataGridColumn TItem="UsuarioDto" Property="Nome" Title="Nome" />
                <RadzenDataGridColumn TItem="UsuarioDto" Property="Email" Title="Email" />
                <RadzenDataGridColumn TItem="UsuarioDto" Property="Tipo" Title="Tipo" Width="140px" TextAlign="TextAlign.Center">
                    <Template Context="user">
                        <RadzenBadge BadgeStyle="@ObterEstiloBadge(user.Tipo)" Text="@user.Tipo.ToString()" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="UsuarioDto" Property="Ativo" Title="Status" Width="140px" TextAlign="TextAlign.Center">
                    <Template Context="user">
                        @if (user.Ativo)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="0.25rem">
                                <RadzenIcon Icon="check_circle" IconColor="var(--rz-success)" />
                                <RadzenText TextStyle="TextStyle.Body2" class="rz-my-0">Ativo</RadzenText>
                            </RadzenStack>
                        }
                        else
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="0.25rem">
                                <RadzenIcon Icon="cancel" IconColor="var(--rz-danger)" />
                                <RadzenText TextStyle="TextStyle.Body2" class="rz-my-0">Inativo</RadzenText>
                            </RadzenStack>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="UsuarioDto" Title="Ações" Sortable="false" Filterable="false" Width="130px" TextAlign="TextAlign.Center">
                    <Template Context="user">
                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Size="ButtonSize.Small"
                                      Click="@(() => Editar(user.Id))" class="rz-me-1" title="Editar" />
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Size="ButtonSize.Small"
                                      Click="@(() => Excluir(user.Id))" title="Excluir" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</RadzenStack>

@code {
    private List<UsuarioDto>? usuarios;

    protected override async Task OnInitializedAsync()
    {
        await AuthStateProvider.GetAuthenticationStateAsync();
        await CarregarUsuarios();
    }

    private async Task CarregarUsuarios()
    {
        try
        {
            var token = await LocalStorage.GetItemAsStringAsync("authToken");
            if (!string.IsNullOrWhiteSpace(token))
            {
                token = token.Replace("\"", "");
                Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            usuarios = await Http.GetFromJsonAsync<List<UsuarioDto>>("api/usuario");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar: {ex.Message}");
        }
    }

    private static BadgeStyle ObterEstiloBadge(TipoUsuario tipo)
    {
        return tipo switch
        {
            TipoUsuario.Admin => BadgeStyle.Danger,
            TipoUsuario.Coordenador => BadgeStyle.Warning,
            TipoUsuario.Professor => BadgeStyle.Info,
            _ => BadgeStyle.Secondary
        };
    }

    private void IrParaNovoUsuario()
    {
        Navigation.NavigateTo("/usuarios/novo");
    }

    private void Editar(int id)
    {
        Navigation.NavigateTo($"/usuarios/editar/{id}");
    }

    private async Task Excluir(int id)
    {
        var confirmado = await DialogService.Confirm(
            "Tem certeza que deseja excluir este usuário? Essa ação não pode ser desfeita.",
            "Excluir usuário",
            new ConfirmOptions { OkButtonText = "Excluir", CancelButtonText = "Cancelar" });

        if (confirmado == true)
        {
            try
            {
                var response = await Http.DeleteAsync($"api/usuario/{id}");

                if (response.IsSuccessStatusCode)
                {
                    await CarregarUsuarios();
                }
                else
                {
                    NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Error,
                        Summary = "Erro ao excluir",
                        Detail = "Erro ao excluir usuário.",
                        Duration = 5000
                    });
                }
            }
            catch (Exception)
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Erro de conexão",
                    Detail = "Erro de conexão com o servidor.",
                    Duration = 5000
                });
            }
        }
    }
}
