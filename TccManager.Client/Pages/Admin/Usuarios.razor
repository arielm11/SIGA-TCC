@page "/usuarios"
@using Microsoft.AspNetCore.Authorization
@using TccManager.Shared.DTOs
@using TccManager.Shared.Enums
@using TccManager.Client.Services
@attribute [Authorize(Roles = "Admin")]
@inject HttpClient Http
@inject NavigationManager Navigation
@inject DialogService DialogService
@inject NotificationService NotificationService

<PageTitle>Usuários</PageTitle>

<RadzenStack Gap="1.5rem">
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
        <RadzenText TextStyle="TextStyle.H4" class="rz-my-0">Gerenciar Usuários</RadzenText>
        <RadzenButton Text="Novo Usuário" Icon="add" ButtonStyle="ButtonStyle.Primary" Click="@IrParaNovoUsuario" />
    </RadzenStack>

    <RadzenDataGrid @ref="grid" Data="@usuarios" Count="@count" TItem="UsuarioResponseDto"
                    LoadData="@CarregarUsuarios" AllowPaging="true" PageSize="10" PageSizeOptions="@(new[] { 10, 20, 50 })"
                    EmptyText="Nenhum usuário encontrado além de você."
                    PageSizeText="Itens por página">
        <Columns>
            <RadzenDataGridColumn TItem="UsuarioResponseDto" Property="Nome" Title="Nome" />
            <RadzenDataGridColumn TItem="UsuarioResponseDto" Property="Email" Title="Email" />
            <RadzenDataGridColumn TItem="UsuarioResponseDto" Property="Tipo" Title="Tipo" Sortable="false" Width="140px" TextAlign="TextAlign.Center">
                <Template Context="user">
                    <RadzenBadge BadgeStyle="@ObterEstiloBadge(user.Tipo)" Text="@user.Tipo.ToString()" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="UsuarioResponseDto" Property="Ativo" Title="Status" Sortable="false" Width="140px" TextAlign="TextAlign.Center">
                <Template Context="user">
                    @if (user.Ativo)
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="0.25rem">
                            <RadzenIcon Icon="check_circle" IconColor="var(--rz-success)" />
                            <RadzenText TextStyle="TextStyle.Body2" class="rz-my-0">Ativo</RadzenText>
                        </RadzenStack>
                    }
                    else
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="0.25rem">
                            <RadzenIcon Icon="cancel" IconColor="var(--rz-danger)" />
                            <RadzenText TextStyle="TextStyle.Body2" class="rz-my-0">Inativo</RadzenText>
                        </RadzenStack>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="UsuarioResponseDto" Title="Ações" Sortable="false" Filterable="false" Width="130px" TextAlign="TextAlign.Center">
                <Template Context="user">
                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Size="ButtonSize.Small"
                                  Click="@(() => Editar(user.Id))" class="rz-me-1" title="Editar" />
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Size="ButtonSize.Small"
                                  Click="@(() => Excluir(user.Id))" title="Excluir" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</RadzenStack>

@code {
    private RadzenDataGrid<UsuarioResponseDto>? grid;
    private List<UsuarioResponseDto> usuarios = new();
    private int count;

    // Issue #154 (achado D5): endpoint passou a paginar no servidor (antes devolvia a lista
    // inteira de uma vez, único endpoint de listagem administrativa sem essa proteção) —
    // mesmo padrão LoadData/PagedResult já usado em GestaoProfessores.razor.
    private async Task CarregarUsuarios(LoadDataArgs args)
    {
        var pageSize = args.Top ?? PaginacaoQuery.DefaultPageSize;
        var page = (args.Skip ?? 0) / pageSize + 1;

        try
        {
            // Issue #158 (achado D12): AuthTokenHandler já anexa o Bearer em toda requisição
            // via DelegatingHandler (fonte única documentada) — setar
            // Http.DefaultRequestHeaders.Authorization aqui era redundante e, por Http ser um
            // HttpClient de escopo efetivamente singleton em Blazor WASM, podia manter um
            // token antigo sendo enviado após logout/troca de usuário na mesma aba.
            var resultado = await Http.GetFromJsonAsync<PagedResult<UsuarioResponseDto>>($"api/usuario?page={page}&pageSize={pageSize}");
            usuarios = resultado?.Items ?? new();
            count = resultado?.TotalCount ?? 0;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar: {ex.Message}");
        }
    }

    private static BadgeStyle ObterEstiloBadge(TipoUsuario tipo)
    {
        return tipo switch
        {
            TipoUsuario.Admin => BadgeStyle.Danger,
            TipoUsuario.Coordenador => BadgeStyle.Warning,
            TipoUsuario.Professor => BadgeStyle.Info,
            _ => BadgeStyle.Secondary
        };
    }

    private void IrParaNovoUsuario()
    {
        Navigation.NavigateTo("/usuarios/novo");
    }

    private void Editar(int id)
    {
        Navigation.NavigateTo($"/usuarios/editar/{id}");
    }

    private async Task Excluir(int id)
    {
        var confirmado = await DialogService.Confirm(
            "Tem certeza que deseja excluir este usuário? Essa ação não pode ser desfeita.",
            "Excluir usuário",
            new ConfirmOptions { OkButtonText = "Excluir", CancelButtonText = "Cancelar" });

        if (confirmado == true)
        {
            try
            {
                var response = await Http.DeleteAsync($"api/usuario/{id}");

                if (response.IsSuccessStatusCode && grid != null)
                {
                    await grid.Reload();
                }
                else
                {
                    // Issue #89: 400/409 trazem o motivo de negocio especifico (ultimo
                    // Admin ativo, vinculo com TCC/banca) — repassar em vez de esconder
                    // atras de uma mensagem generica que nao ajuda o Admin a entender.
                    var detalhe = "Erro ao excluir usuário.";

                    if (response.StatusCode is System.Net.HttpStatusCode.BadRequest or System.Net.HttpStatusCode.Conflict)
                    {
                        var corpo = await response.Content.ReadAsStringAsync();
                        if (!string.IsNullOrWhiteSpace(corpo))
                            detalhe = corpo;
                    }

                    NotificationService.NotificarErro("Erro ao excluir", detalhe);
                }
            }
            catch (Exception)
            {
                NotificationService.NotificarErro("Erro de conexão", "Erro de conexão com o servidor.");
            }
        }
    }
}
