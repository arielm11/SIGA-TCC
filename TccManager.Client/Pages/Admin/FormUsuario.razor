@page "/usuarios/novo"
@page "/usuarios/editar/{id:int}"
@using Microsoft.AspNetCore.Authorization
@using TccManager.Shared.DTOs
@using TccManager.Shared.Enums
@using TccManager.Client.Services
@attribute [Authorize(Roles = "Admin")]
@inject HttpClient Http
@inject NavigationManager Navigation
@inject NotificationService NotificationService

<PageTitle>@(Id.HasValue ? "Editar Usuário" : "Novo Usuário")</PageTitle>

<RadzenStack Gap="1.5rem" style="max-width: 800px; margin: 0 auto;">
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
        <RadzenText TextStyle="TextStyle.H4" class="rz-my-0">@(Id.HasValue ? "Editar Usuário" : "Novo Usuário")</RadzenText>
        <RadzenButton Text="Voltar" Icon="arrow_back" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Click="@(() => Navigation.NavigateTo("/usuarios"))" />
    </RadzenStack>

    <RadzenCard Variant="Variant.Filled" class="rz-shadow-2">
        <EditForm Model="usuario" OnValidSubmit="SalvarUsuario">
            <DataAnnotationsValidator />

            <RadzenStack Gap="1rem">
                <RadzenRow Gap="1rem">
                    <RadzenColumn SizeMD="6" SizeXS="12">
                        <RadzenFormField Text="Nome Completo" Variant="Variant.Outlined" style="width: 100%;">
                            <RadzenTextBox Name="Nome" @bind-Value="usuario.Nome" style="width: 100%;" />
                        </RadzenFormField>
                        <ValidationMessage For="@(() => usuario.Nome)" />
                    </RadzenColumn>

                    <RadzenColumn SizeMD="6" SizeXS="12">
                        <RadzenFormField Text="E-mail" Variant="Variant.Outlined" style="width: 100%;">
                            <RadzenTextBox Name="Email" @bind-Value="usuario.Email" style="width: 100%;" />
                        </RadzenFormField>
                        <ValidationMessage For="@(() => usuario.Email)" />
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="1rem">
                    <RadzenColumn SizeMD="6" SizeXS="12">
                        <RadzenFormField Text="Senha" Variant="Variant.Outlined" style="width: 100%;">
                            <RadzenPassword Name="Senha" @bind-Value="usuario.Senha"
                                            Placeholder="@(Id.HasValue ? "Deixe em branco para manter a atual" : "******")"
                                            style="width: 100%;" />
                        </RadzenFormField>
                        @if (Id.HasValue)
                        {
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-my-0">Preencha apenas se quiser alterar a senha.</RadzenText>
                        }
                        else
                        {
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-my-0">Senha inicial obrigatória.</RadzenText>
                        }
                        <ValidationMessage For="@(() => usuario.Senha)" />
                    </RadzenColumn>

                    <RadzenColumn SizeMD="6" SizeXS="12">
                        <RadzenFormField Text="Nível de Acesso" Variant="Variant.Outlined" style="width: 100%;">
                            <RadzenDropDown Name="Tipo" TValue="TipoUsuario" Data="@tiposDisponiveis" TextProperty="Value" ValueProperty="Key" @bind-Value="usuario.Tipo" style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                @if (Id.HasValue)
                {
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenCheckBox Name="Ativo" @bind-Value="usuario.Ativo" />
                        <RadzenLabel Component="Ativo" Text="Usuário Ativo" />
                    </RadzenStack>
                }

                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                    <RadzenButton ButtonType="ButtonType.Submit"
                                  Text="@(Id.HasValue ? "Atualizar" : "Cadastrar")"
                                  Icon="check"
                                  IsBusy="carregando"
                                  BusyText="Salvando..."
                                  ButtonStyle="ButtonStyle.Primary" />
                </RadzenStack>
            </RadzenStack>
        </EditForm>
    </RadzenCard>
</RadzenStack>

@code {
    [Parameter]
    public int? Id { get; set; }

    private UsuarioDto usuario = new() { Ativo = true, Tipo = TipoUsuario.Aluno };
    private bool carregando = false;
    private readonly List<KeyValuePair<TipoUsuario, string>> tiposDisponiveis = Enum.GetValues<TipoUsuario>()
        .Select(t => new KeyValuePair<TipoUsuario, string>(t, t.ToString()))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            try
            {
                // Issue #165 (achado A1/B3): GET devolve UsuarioResponseDto (sem Senha) —
                // "usuario" aqui é o modelo de escrita (UsuarioDto), populado a partir da
                // leitura; Senha fica vazia ("manter a atual", comportamento já existente).
                var lido = await Http.GetFromJsonAsync<UsuarioResponseDto>($"api/usuario/{Id}");
                if (lido != null)
                {
                    usuario = new UsuarioDto
                    {
                        Nome = lido.Nome,
                        Email = lido.Email,
                        Tipo = lido.Tipo,
                        Ativo = lido.Ativo
                    };
                }
            }
            catch (Exception)
            {
                NotificationService.NotificarErro("Erro ao carregar", "Erro ao carregar usuário. Talvez ele não exista.");
            }
        }
    }

    private async Task SalvarUsuario()
    {
        carregando = true;

        if (!Id.HasValue && string.IsNullOrWhiteSpace(usuario.Senha))
        {
            NotificationService.NotificarAviso("Senha obrigatória", "A senha é obrigatória para novos usuários.");
            carregando = false;
            return;
        }

        try
        {
            HttpResponseMessage response;

            if (Id.HasValue)
            {
                response = await Http.PutAsJsonAsync($"api/usuario/{Id}", usuario);
            }
            else
            {
                response = await Http.PostAsJsonAsync("api/usuario", usuario);
            }

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/usuarios");
            }
            else
            {
                var erro = await response.Content.ReadAsStringAsync();
                NotificationService.NotificarErro("Erro ao salvar", $"Erro ao salvar: {erro}");
            }
        }
        catch (Exception ex)
        {
            NotificationService.NotificarErro("Erro de conexão", "Erro de conexão com o servidor.");
            Console.WriteLine(ex.Message);
        }
        finally
        {
            carregando = false;
        }
    }
}
