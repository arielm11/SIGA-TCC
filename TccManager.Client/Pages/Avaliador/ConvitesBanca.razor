@page "/avaliador/convites"
@using Microsoft.AspNetCore.Authorization
@using TccManager.Shared.DTOs
@attribute [Authorize(Roles = "Professor")]
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject NotificationService NotificationService

<PageTitle>Meus Convites de Banca</PageTitle>

<RadzenStack Gap="1.5rem">
    <RadzenStack Gap="0.25rem">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenIcon Icon="mail" />
            <RadzenText TextStyle="TextStyle.H4" class="rz-my-0">Meus Convites de Banca</RadzenText>
        </RadzenStack>
        <RadzenText TextStyle="TextStyle.Body2" class="rz-my-0">
            Acompanhe aqui as defesas de TCC para as quais você foi convocado como avaliador e baixe os arquivos para leitura prévia.
        </RadzenText>
    </RadzenStack>

    @if (carregando)
    {
        <RadzenStack AlignItems="AlignItems.Center" Gap="1rem" class="rz-p-6">
            <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Mode="ProgressBarMode.Indeterminate" />
            <RadzenText TextStyle="TextStyle.Body2" class="rz-my-0">Buscando convites...</RadzenText>
        </RadzenStack>
    }
    else if (!convites.Any())
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" ShowIcon="true" class="rz-text-align-center rz-p-4">
            <RadzenText TextStyle="TextStyle.H6" class="rz-my-0">Nenhum convite encontrado</RadzenText>
            <RadzenText class="rz-my-0">Você não possui alocações em bancas de TCC ativas no momento.</RadzenText>
        </RadzenAlert>
    }
    else
    {
        <RadzenRow Gap="1rem">
            @foreach (var convite in convites)
            {
                <RadzenColumn SizeMD="6" SizeXS="12">
                    <RadzenCard Variant="Variant.Outlined" class="rz-shadow-2 rz-h-100">
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" class="rz-mb-3">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.4rem">
                                <RadzenIcon Icon="event" />
                                <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-my-0">@convite.DataHora.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</RadzenText>
                            </RadzenStack>
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem">
                                <RadzenIcon Icon="location_on" />
                                <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@convite.Local" />
                            </RadzenStack>
                        </RadzenStack>

                        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">@convite.TccTitulo</RadzenText>

                        <RadzenText class="rz-mb-1">
                            <RadzenIcon Icon="person" /> <strong>Aluno(a):</strong> @convite.NomeAluno
                        </RadzenText>
                        <RadzenText class="rz-mb-4">
                            <RadzenIcon Icon="badge" /> <strong>Orientador(a):</strong> @convite.NomeOrientador
                        </RadzenText>

                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                            <RadzenButton Text="Baixar Rascunho da Ata" Icon="picture_as_pdf" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined"
                                          IsBusy="@(bancaIdBaixandoRascunho == convite.BancaId)" BusyText="Baixando..."
                                          Disabled="@(bancaIdBaixandoRascunho == convite.BancaId)"
                                          Click="@(() => BaixarAtaRascunho(convite.BancaId))" />

                            @if (convite.ArquivoFinalEntregaId.HasValue)
                            {
                                <button type="button" @onclick="@(() => BaixarArquivoFinal(convite.ArquivoFinalEntregaId.Value, convite.ArquivoFinalExtensao))"
                                        disabled="@(entregaIdBaixando == convite.ArquivoFinalEntregaId)"
                                        style="display:inline-flex; align-items:center; gap:0.4rem; padding: 0.5rem 1rem; border-radius: 4px; border: none; background-color: var(--rz-success); color: var(--rz-on-success, #fff); text-decoration:none; font-weight:500; white-space:nowrap; cursor:pointer;">
                                    <RadzenIcon Icon="picture_as_pdf" IconColor="inherit" />
                                    @(entregaIdBaixando == convite.ArquivoFinalEntregaId ? "Baixando..." : "Baixar Versão Final (TCC)")
                                </button>
                            }
                            else
                            {
                                <RadzenButton Text="Arquivo Indisponível" Icon="disabled_by_default" ButtonStyle="ButtonStyle.Secondary" Disabled="true"
                                              title="O aluno não enviou a versão final corretamente." />
                            }
                        </RadzenStack>
                    </RadzenCard>
                </RadzenColumn>
            }
        </RadzenRow>
    }
</RadzenStack>

@code {
    private bool carregando = true;
    private int? entregaIdBaixando;
    private List<ConviteBancaDto> convites = new();
    private int? bancaIdBaixandoRascunho;

    protected override async Task OnInitializedAsync()
    {
        await CarregarConvites();
    }

    // Download autenticado do arquivo da entrega Final (o endpoint estático sem autenticação
    // foi removido — ver TccManager.Api Program.cs / A01-1); busca via HttpClient (Bearer já
    // anexado pelo AuthTokenHandler) e dispara o download via blob, mesmo padrão de
    // BaixarAtaRascunho abaixo e de DetalhesTcc.razor.
    private async Task BaixarArquivoFinal(int entregaId, string? extensao)
    {
        entregaIdBaixando = entregaId;
        try
        {
            var response = await Http.GetAsync($"api/tcc/entregas/{entregaId}/download");

            if (response.IsSuccessStatusCode)
            {
                var bytes = await response.Content.ReadAsByteArrayAsync();
                var base64 = Convert.ToBase64String(bytes);
                await JSRuntime.InvokeVoidAsync("downloadFileFromBytes", $"entrega-{entregaId}{extensao}", "application/octet-stream", base64);
            }
            else
            {
                var detalhe = response.StatusCode switch
                {
                    System.Net.HttpStatusCode.Forbidden => "Você não tem permissão para baixar este arquivo.",
                    System.Net.HttpStatusCode.NotFound => "Arquivo não encontrado.",
                    _ => "Não foi possível baixar o arquivo. Tente novamente mais tarde."
                };

                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Erro ao baixar arquivo",
                    Detail = detalhe,
                    Duration = 5000
                });
            }
        }
        catch
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Erro de conexão",
                Detail = "Erro de conexão ao baixar o arquivo.",
                Duration = 5000
            });
        }
        finally
        {
            entregaIdBaixando = null;
        }
    }

    private async Task CarregarConvites()
    {
        carregando = true;
        try
        {
            convites = await Http.GetFromJsonAsync<List<ConviteBancaDto>>("api/avaliador/meus-convites") ?? new();
        }
        catch
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Erro de conexão",
                Detail = "Erro de conexão ao buscar seus convites de banca.",
                Duration = 5000
            });
        }
        finally
        {
            carregando = false;
        }
    }

    // RF-03/Etapa 2: download do PDF rascunho pré-defesa. O backend valida (RNF-01) que o
    // professor autenticado é de fato um avaliador desta banca; 403/404/410 exibem o erro.
    private async Task BaixarAtaRascunho(int bancaId)
    {
        bancaIdBaixandoRascunho = bancaId;
        try
        {
            var response = await Http.GetAsync($"api/avaliador/banca/{bancaId}/ata-rascunho-pdf");

            if (response.IsSuccessStatusCode)
            {
                var bytes = await response.Content.ReadAsByteArrayAsync();
                var base64 = Convert.ToBase64String(bytes);
                await JSRuntime.InvokeVoidAsync("downloadFileFromBytes", $"ata-rascunho-{bancaId}.pdf", "application/pdf", base64);
            }
            else
            {
                var erro = await response.Content.ReadAsStringAsync();
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Erro",
                    Detail = $"Erro ao baixar o rascunho da ata: {erro}",
                    Duration = 6000
                });
            }
        }
        finally
        {
            bancaIdBaixandoRascunho = null;
        }
    }
}
