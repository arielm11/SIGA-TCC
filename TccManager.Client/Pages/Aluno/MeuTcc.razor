@page "/meu-tcc"
@using Microsoft.AspNetCore.Authorization
@using TccManager.Shared.DTOs
@using TccManager.Shared.Models
@using TccManager.Shared.Enums
@attribute [Authorize(Roles = "Aluno")]
@inject HttpClient Http
@inject DialogService DialogService
@inject NotificationService NotificationService

<PageTitle>Meu TCC</PageTitle>

<RadzenStack Gap="1.5rem" style="max-width: 900px; margin: 0 auto;">
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenIcon Icon="menu_book" />
            <RadzenText TextStyle="TextStyle.H4" class="rz-my-0">Meu TCC</RadzenText>
        </RadzenStack>

        @if (tccExistente != null && tccExistente.Status == StatusTcc.Pendente)
        {
            <RadzenButton Text="Excluir Proposta" Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Click="@ExcluirProposta" />
        }
    </RadzenStack>

    @if (carregando)
    {
        <RadzenStack AlignItems="AlignItems.Center" Gap="1rem" class="rz-p-6">
            <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Mode="ProgressBarMode.Indeterminate" />
            <RadzenText TextStyle="TextStyle.Body2" class="rz-my-0">Verificando situação...</RadzenText>
        </RadzenStack>
    }
    else if (tccExistente != null && tccExistente.Status != StatusTcc.Reprovado)
    {
        <RadzenCard Variant="Variant.Outlined" class="rz-shadow-2">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" class="rz-mb-3">
                <RadzenText TextStyle="TextStyle.H6" class="rz-my-0">Situação da Proposta</RadzenText>
                <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@tccExistente.Status.ToString()" />
            </RadzenStack>

            <RadzenText TextStyle="TextStyle.H5" class="rz-my-0">@tccExistente.Titulo</RadzenText>
            <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-3">Enviado em: @tccExistente.DataCriacao.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</RadzenText>

            <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-1">Resumo / Objetivo:</RadzenText>
            <RadzenText style="white-space: pre-line;" class="rz-mb-4">@tccExistente.Resumo</RadzenText>

            @if (tccExistente.Status == StatusTcc.Pendente)
            {
                <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" ShowIcon="true">
                    Sua proposta está sendo analisada. Se precisar alterar algo, exclua a proposta acima e envie uma nova.
                </RadzenAlert>
            }
            else if (tccExistente.Status == StatusTcc.Aprovado)
            {
                <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" ShowIcon="true" class="rz-mb-4">
                    Sua proposta foi aprovada e seu TCC está em andamento!
                </RadzenAlert>

                <RadzenTabs RenderMode="TabRenderMode.Client">
                    <Tabs>
                        <RadzenTabsItem Text="Entregas & Arquivos" Icon="cloud_upload">
                            @if (entregasFeitas != null && entregasFeitas.Any(e => e.Tipo == TipoEntrega.Final))
                            {
                                <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" ShowIcon="true" class="rz-mb-4">
                                    <RadzenText TextStyle="TextStyle.H6" class="rz-my-0"><RadzenIcon Icon="emoji_events" IconColor="var(--rz-warning)" /> Trabalho Concluído!</RadzenText>
                                    <RadzenText class="rz-my-0">Você já enviou a Versão Final do seu TCC. Agora é só aguardar as avaliações finais e a Banca.</RadzenText>
                                </RadzenAlert>
                            }
                            else
                            {
                                <RadzenText TextStyle="TextStyle.H6" class="rz-mt-1 rz-mb-2"><RadzenIcon Icon="cloud_upload" /> Nova Entrega</RadzenText>
                                <RadzenCard Variant="Variant.Flat" class="rz-mb-4">
                                    <RadzenRow Gap="1rem">
                                        <RadzenColumn SizeMD="6" SizeXS="12">
                                            <RadzenFormField Text="Título da Entrega" Variant="Variant.Outlined" style="width: 100%;">
                                                <RadzenTextBox @bind-Value="novaEntregaTitulo" Placeholder="Ex: Capítulos 1 e 2" style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                        <RadzenColumn SizeMD="6" SizeXS="12">
                                            <RadzenFormField Text="Tipo de Entrega" Variant="Variant.Outlined" style="width: 100%;">
                                                <RadzenDropDown TValue="TipoEntrega" Data="@tiposEntregaDisponiveis" TextProperty="Value" ValueProperty="Key" @bind-Value="novaEntregaTipo" style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                        <RadzenColumn Size="12">
                                            <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-2">Arquivo (.pdf, .doc, .zip)</RadzenText>
                                            <RadzenUpload @ref="uploadEntregaRef" Auto="false" Multiple="false" Accept=".pdf,.doc,.docx,.zip" ChooseText="Selecionar Arquivo" Change="@CarregarArquivo" />
                                            @if (arquivoSelecionado != null)
                                            {
                                                <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-2 rz-my-0">
                                                    <RadzenIcon Icon="check_circle" IconColor="var(--rz-success)" /> Arquivo selecionado: @arquivoSelecionado.Name
                                                </RadzenText>
                                            }
                                        </RadzenColumn>
                                        <RadzenColumn Size="12">
                                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                                                <RadzenButton Text="Enviar Arquivo" Icon="upload" ButtonStyle="ButtonStyle.Primary"
                                                              IsBusy="enviando" BusyText="Enviando..."
                                                              Disabled="@(arquivoSelecionado == null || enviando)"
                                                              Click="@FazerUploadEntrega" />
                                            </RadzenStack>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenCard>
                            }

                            <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2"><RadzenIcon Icon="checklist" /> Histórico de Entregas</RadzenText>
                            @if (entregasFeitas == null)
                            {
                                <RadzenText TextStyle="TextStyle.Body2">Carregando histórico...</RadzenText>
                            }
                            else
                            {
                                <RadzenDataGrid @ref="gridEntregas" Data="@entregasFeitas" TItem="Entrega"
                                                AllowPaging="true" PageSize="10" PageSizeOptions="@(new[] { 10, 20, 50 })"
                                                AllowSorting="true" EmptyText="Nenhuma entrega realizada ainda." PageSizeText="Itens por página">
                                    <Columns>
                                        <RadzenDataGridColumn TItem="Entrega" Property="Titulo" Title="Título" />
                                        <RadzenDataGridColumn TItem="Entrega" Property="Tipo" Title="Tipo" Width="120px" TextAlign="TextAlign.Center">
                                            <Template Context="entrega">
                                                <RadzenBadge BadgeStyle="BadgeStyle.Secondary" Text="@entrega.Tipo.ToString()" />
                                            </Template>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn TItem="Entrega" Property="DataEnvio" Title="Data de Envio" Width="170px">
                                            <Template Context="entrega">
                                                @entrega.DataEnvio.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                            </Template>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn TItem="Entrega" Title="Parecer do Orientador" Sortable="false" Filterable="false" Width="260px">
                                            <Template Context="entrega">
                                                @if (entrega.Nota.HasValue || !string.IsNullOrEmpty(entrega.Feedback))
                                                {
                                                    <RadzenButton Text="@(entregaSelecionadaParaFeedback == entrega.Id ? "Fechar Feedback" : "Ler Feedback")"
                                                                  Icon="chat" ButtonStyle="ButtonStyle.Info" Variant="Variant.Outlined" Size="ButtonSize.Small"
                                                                  Click="@(() => AlternarFeedback(entrega.Id))" />

                                                    @if (entregaSelecionadaParaFeedback == entrega.Id)
                                                    {
                                                        <RadzenCard Variant="Variant.Outlined" class="rz-mt-2">
                                                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Start">
                                                                <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-my-0">Parecer do Orientador</RadzenText>
                                                                @if (entrega.Nota.HasValue)
                                                                {
                                                                    <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="@($"Nota: {entrega.Nota}")" />
                                                                }
                                                            </RadzenStack>
                                                            <RadzenText style="white-space: pre-line;" class="rz-mt-2 rz-mb-0">
                                                                @(string.IsNullOrEmpty(entrega.Feedback) ? "Nenhum comentário por texto foi deixado." : entrega.Feedback)
                                                            </RadzenText>
                                                        </RadzenCard>
                                                    }
                                                }
                                                else
                                                {
                                                    <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="Aguardando Avaliação" />
                                                }
                                            </Template>
                                        </RadzenDataGridColumn>
                                    </Columns>
                                </RadzenDataGrid>
                            }
                        </RadzenTabsItem>

                        <RadzenTabsItem Text="Reuniões (Atas)" Icon="event">
                            <RadzenText TextStyle="TextStyle.H6" class="rz-mb-1"><RadzenIcon Icon="history_edu" /> Atas de Reunião</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-3">Abaixo estão os registros das suas reuniões de orientação feitas pelo seu professor.</RadzenText>

                            @if (meusAcompanhamentos == null)
                            {
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-py-3">
                                    <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Mode="ProgressBarMode.Indeterminate" style="width: 24px; height: 24px;" />
                                    <RadzenText class="rz-my-0">Carregando atas...</RadzenText>
                                </RadzenStack>
                            }
                            else if (!meusAcompanhamentos.Any())
                            {
                                <RadzenAlert AlertStyle="AlertStyle.Secondary" Variant="Variant.Flat" ShowIcon="true">
                                    Nenhuma reunião foi registrada pelo seu orientador até o momento.
                                </RadzenAlert>
                            }
                            else
                            {
                                <RadzenAccordion>
                                    <Items>
                                        @foreach (var ata in meusAcompanhamentos)
                                        {
                                            <RadzenAccordionItem Text="@($"Reunião do dia {ata.DataReuniao.ToLocalTime():dd/MM/yyyy}")" Icon="event_available">
                                                <p style="white-space: pre-line;">@ata.Ata</p>
                                            </RadzenAccordionItem>
                                        }
                                    </Items>
                                </RadzenAccordion>
                            }
                        </RadzenTabsItem>

                        <RadzenTabsItem Text="Minha Banca" Icon="groups">
                            @if (!carregouBanca)
                            {
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-py-3">
                                    <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Mode="ProgressBarMode.Indeterminate" style="width: 24px; height: 24px;" />
                                    <RadzenText class="rz-my-0">Buscando informações...</RadzenText>
                                </RadzenStack>
                            }
                            else if (minhaBanca == null)
                            {
                                <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" ShowIcon="true">
                                    <RadzenText TextStyle="TextStyle.H6" class="rz-my-0">Banca ainda não agendada</RadzenText>
                                    <RadzenText class="rz-my-0">O Coordenador do curso ainda não definiu a data e os membros da sua banca. Continue focado no seu trabalho e fique atento às atualizações!</RadzenText>
                                </RadzenAlert>
                            }
                            else
                            {
                                <RadzenCard Variant="Variant.Flat">
                                    <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3"><RadzenIcon Icon="event_available" /> Detalhes da Defesa</RadzenText>

                                    <RadzenRow class="rz-mb-4">
                                        <RadzenColumn SizeMD="6" SizeXS="12">
                                            <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-1"><RadzenIcon Icon="schedule" /> Data e Hora</RadzenText>
                                            <RadzenText TextStyle="TextStyle.Body1" class="rz-my-0">@minhaBanca.DataHora.ToLocalTime().ToString("dd/MM/yyyy 'às' HH:mm")</RadzenText>
                                        </RadzenColumn>
                                        <RadzenColumn SizeMD="6" SizeXS="12">
                                            <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-1"><RadzenIcon Icon="location_on" /> Local / Link</RadzenText>
                                            <RadzenText TextStyle="TextStyle.Body1" class="rz-my-0">@minhaBanca.Local</RadzenText>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-2"><RadzenIcon Icon="groups" /> Professores Avaliadores</RadzenText>
                                    @if (minhaBanca.Professores.Any())
                                    {
                                        <RadzenStack Gap="0.5rem">
                                            @foreach (var prof in minhaBanca.Professores)
                                            {
                                                <RadzenText class="rz-my-0"><RadzenIcon Icon="badge" /> @prof</RadzenText>
                                            }
                                        </RadzenStack>
                                    }
                                    else
                                    {
                                        <RadzenText TextStyle="TextStyle.Body2" class="rz-my-0">Membros da banca ainda não foram definidos.</RadzenText>
                                    }
                                </RadzenCard>
                            }
                        </RadzenTabsItem>
                    </Tabs>
                </RadzenTabs>
            }
        </RadzenCard>
    }
    else
    {
        <RadzenCard Variant="Variant.Outlined" class="rz-shadow-2">
            @if (tccExistente != null && tccExistente.Status == StatusTcc.Reprovado)
            {
                @if (FoiReprovadoNaBanca(tccExistente))
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" ShowIcon="true" class="rz-mb-4">
                        <RadzenText TextStyle="TextStyle.H6" class="rz-my-0">TCC Reprovado na Banca</RadzenText>
                        <RadzenText class="rz-my-0">O seu trabalho ("<strong>@tccExistente.Titulo</strong>") foi avaliado pela banca examinadora e <strong>não atingiu a nota mínima de aprovação</strong>.</RadzenText>
                        <RadzenText class="rz-my-0"><strong>Motivo apontado pela banca:</strong> @tccExistente.MotivoRejeicao</RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-my-0">Entre em contato com a Coordenação do curso para entender os próximos passos do seu processo acadêmico.</RadzenText>
                    </RadzenAlert>
                }
                else
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" ShowIcon="true" class="rz-mb-4">
                        <RadzenText TextStyle="TextStyle.H6" class="rz-my-0">Proposta Rejeitada</RadzenText>
                        <RadzenText class="rz-my-0">A sua proposta anterior ("<strong>@tccExistente.Titulo</strong>") foi avaliada e rejeitada pela Coordenação.</RadzenText>
                        <RadzenText class="rz-my-0"><strong>Motivo apontado:</strong> @tccExistente.MotivoRejeicao</RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-my-0">Por favor, ajuste o tema e submeta uma nova proposta abaixo.</RadzenText>
                    </RadzenAlert>
                }
            }
            else
            {
                <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" ShowIcon="true" class="rz-mb-4">
                    Para iniciar, submeta os dados da sua proposta de TCC.
                </RadzenAlert>
            }

            <EditForm Model="proposta" OnValidSubmit="EnviarProposta">
                <DataAnnotationsValidator />

                <RadzenStack Gap="1rem">
                    <div>
                        <RadzenFormField Text="Título do Trabalho" Variant="Variant.Outlined" style="width: 100%;">
                            <RadzenTextBox Name="Titulo" @bind-Value="proposta.Titulo" Placeholder="Digite o título..." MaxLength="200" style="width: 100%;" />
                        </RadzenFormField>
                        <ValidationMessage For="@(() => proposta.Titulo)" />
                    </div>

                    <div>
                        <RadzenFormField Text="Resumo / Objetivo" Variant="Variant.Outlined" style="width: 100%;">
                            <RadzenTextArea Name="Resumo" @bind-Value="proposta.Resumo" Rows="6" Placeholder="Descreva seu projeto..." style="width: 100%;" />
                        </RadzenFormField>
                        <ValidationMessage For="@(() => proposta.Resumo)" />
                    </div>

                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                        <RadzenButton ButtonType="ButtonType.Submit" Text="Submeter Proposta" Icon="send"
                                      ButtonStyle="ButtonStyle.Success" IsBusy="enviando" BusyText="Enviando..." />
                    </RadzenStack>
                </RadzenStack>
            </EditForm>
        </RadzenCard>
    }
</RadzenStack>

@code {
    private bool carregando = true;
    private bool enviando = false;
    private Tcc? tccExistente;
    private PropostaTccDto proposta = new();
    private string novaEntregaTitulo = "";
    private TipoEntrega novaEntregaTipo = TipoEntrega.Parcial;
    private readonly List<KeyValuePair<TipoEntrega, string>> tiposEntregaDisponiveis = Enum.GetValues<TipoEntrega>()
        .Select(t => new KeyValuePair<TipoEntrega, string>(t, t.ToString()))
        .ToList();
    private Radzen.FileInfo? arquivoSelecionado;
    private RadzenUpload? uploadEntregaRef;
    private List<Entrega>? entregasFeitas;
    private int? entregaSelecionadaParaFeedback;
    private List<Acompanhamento>? meusAcompanhamentos;
    private BancaInfoDto? minhaBanca;
    private bool carregouBanca = false;

    private RadzenDataGrid<Entrega>? gridEntregas;
    private bool gridEntregasReloadFeita;

    protected override async Task OnInitializedAsync()
    {
        await CarregarDadosDoTcc();
    }

    // Grid de entregas é client-side (Data), não depende de LoadData/Reload para a carga
    // inicial. Mesmo assim, seguindo a prática defensiva já adotada nas etapas anteriores,
    // capturamos a referência e chamamos Reload() explicitamente assim que ela aparecer
    // disponível (a aba "Entregas" só é montada de fato depois que carregando vira false).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!gridEntregasReloadFeita && gridEntregas != null)
        {
            gridEntregasReloadFeita = true;
            await gridEntregas.Reload();
        }
    }

    private async Task CarregarDadosDoTcc()
    {
        try
        {
            var response = await Http.GetAsync("api/tcc/meu-tcc");
            if (response.IsSuccessStatusCode)
            {
                if (response.StatusCode == System.Net.HttpStatusCode.NoContent)
                {
                    tccExistente = null;
                }
                else
                {
                    tccExistente = await response.Content.ReadFromJsonAsync<Tcc>();
                    if (tccExistente != null && tccExistente.Status == StatusTcc.Aprovado)
                    {
                        await CarregarEntregas();
                    }
                }
            }
        }
        catch (Exception)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Erro de conexão",
                Detail = "Erro de conexão com o servidor.",
                Duration = 5000
            });
        }
        finally
        {
            carregando = false;
        }
    }

    private async Task CarregarEntregas()
    {
        var entregasPaginado = await Http.GetFromJsonAsync<PagedResult<Entrega>>($"api/tcc/entregas?pageSize={PaginacaoQuery.MaxPageSize}");
        entregasFeitas = entregasPaginado?.Items ?? new();

        meusAcompanhamentos = await Http.GetFromJsonAsync<List<Acompanhamento>>("api/tcc/acompanhamentos");

        await CarregarBanca();

        if (gridEntregas != null)
        {
            await gridEntregas.Reload();
        }
    }

    private void CarregarArquivo(Radzen.UploadChangeEventArgs args)
    {
        arquivoSelecionado = args.Files?.FirstOrDefault();
    }

    private async Task FazerUploadEntrega()
    {
        if (arquivoSelecionado == null || string.IsNullOrWhiteSpace(novaEntregaTitulo))
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Campos obrigatórios",
                Detail = "Preencha o título e selecione um arquivo.",
                Duration = 5000
            });
            return;
        }

        enviando = true;
        try
        {
            using var content = new MultipartFormDataContent();
            content.Add(new StringContent(novaEntregaTitulo), "tituloEntrega");
            content.Add(new StringContent(novaEntregaTipo.ToString()), "tipo");

            // max size: 10MB
            var streamContent = new StreamContent(arquivoSelecionado.OpenReadStream(1024 * 1024 * 10));
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(arquivoSelecionado.ContentType);
            content.Add(streamContent, "arquivo", arquivoSelecionado.Name);

            var response = await Http.PostAsync("api/tcc/entregas", content);

            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Entrega enviada",
                    Detail = "Entrega enviada com sucesso!",
                    Duration = 4000
                });
                novaEntregaTitulo = "";
                arquivoSelecionado = null;
                if (uploadEntregaRef != null)
                {
                    await uploadEntregaRef.ClearFiles();
                }
                await CarregarEntregas(); // Atualiza a lista na tela
            }
            else
            {
                var erro = await response.Content.ReadAsStringAsync();
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Erro ao enviar",
                    Detail = $"Erro ao enviar: {erro}",
                    Duration = 6000
                });
            }
        }
        catch (Exception)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Erro",
                Detail = "Ocorreu um erro ao enviar o arquivo. Verifique o tamanho.",
                Duration = 6000
            });
        }
        finally
        {
            enviando = false;
        }
    }

    private async Task EnviarProposta()
    {
        enviando = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/tcc/proposta", proposta);

            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Proposta enviada",
                    Detail = "Proposta enviada com sucesso!",
                    Duration = 4000
                });
                proposta = new PropostaTccDto();
                await CarregarDadosDoTcc();
            }
            else
            {
                var erro = await response.Content.ReadAsStringAsync();
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Erro ao enviar",
                    Detail = $"Erro ao enviar: {erro}",
                    Duration = 6000
                });
            }
        }
        catch (Exception)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Erro de conexão",
                Detail = "Erro de conexão ao enviar a proposta.",
                Duration = 5000
            });
        }
        finally
        {
            enviando = false;
        }
    }

    private async Task ExcluirProposta()
    {
        var confirmado = await DialogService.Confirm(
            "Tem certeza que deseja cancelar e excluir esta proposta? Você terá que enviar uma nova depois.",
            "Excluir proposta",
            new ConfirmOptions { OkButtonText = "Excluir", CancelButtonText = "Cancelar" });

        if (confirmado == true && tccExistente != null)
        {
            try
            {
                var response = await Http.DeleteAsync($"api/tcc/proposta/{tccExistente.Id}");

                if (response.IsSuccessStatusCode)
                {
                    NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Success,
                        Summary = "Proposta excluída",
                        Detail = "Proposta excluída com sucesso.",
                        Duration = 4000
                    });
                    tccExistente = null;
                }
                else
                {
                    var erro = await response.Content.ReadAsStringAsync();
                    NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Error,
                        Summary = "Erro ao excluir",
                        Detail = $"Erro ao excluir: {erro}",
                        Duration = 6000
                    });
                }
            }
            catch (Exception)
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Erro de conexão",
                    Detail = "Erro de conexão com o servidor.",
                    Duration = 5000
                });
            }
        }
    }

    private void AlternarFeedback(int entregaId)
    {
        entregaSelecionadaParaFeedback = entregaSelecionadaParaFeedback == entregaId ? null : entregaId;
    }

    private async Task CarregarBanca()
    {
        try
        {
            var response = await Http.GetAsync("api/tcc/minha-banca");
            if (response.StatusCode == System.Net.HttpStatusCode.NoContent)
            {
                minhaBanca = null;
            }
            else if (response.IsSuccessStatusCode)
            {
                minhaBanca = await response.Content.ReadFromJsonAsync<BancaInfoDto>();
            }
        }
        catch (Exception)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Erro",
                Detail = "Erro ao carregar informações da banca.",
                Duration = 5000
            });
        }
        finally
        {
            carregouBanca = true;
        }
    }

    private bool FoiReprovadoNaBanca(Tcc tcc)
    {
        return tcc.Entregas != null && tcc.Entregas.Any(e => e.Tipo == TipoEntrega.Final);
    }

    private class BancaInfoDto
    {
        public DateTime DataHora { get; set; }
        public string Local { get; set; } = "";
        public List<string> Professores { get; set; } = new();
    }
}
