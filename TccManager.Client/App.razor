@using Microsoft.AspNetCore.Components.Authorization
@using TccManager.Client.Layout
@inject NavigationManager Navigation

<CascadingAuthenticationState>
    @* Host único de diálogos/notificações/tooltips/context menu (DialogService, NotificationService,
       TooltipService, ContextMenuService). Fica aqui, acima do Router, para servir tanto o
       LoginLayout (sem MainLayout) quanto o MainLayout. *@
    <RadzenComponents />
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <TccManager.Client.Layout.RedirectToLogin />
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Não encontrado</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <RadzenStack AlignItems="AlignItems.Center" Gap="1rem" class="rz-p-6">
                    <RadzenIcon Icon="search_off" Style="font-size: 2.5rem;" />
                    <p role="alert">Desculpe, não há nada neste endereço.</p>
                    <RadzenButton Text="Voltar para o início" Icon="home" ButtonStyle="ButtonStyle.Primary"
                                  Click='@(() => Navigation.NavigateTo("/"))' />
                </RadzenStack>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>