@* Diálogo de rejeição de proposta (N3 Etapa 4 — originalmente Professor/Dashboard;
   issue #76/D9 — chamador passou a ser Coordenador/Dashboard).
   Aberto via DialogService.OpenAsync<RejeitarPropostaDialog>.
   Fecha retornando o motivo (string) via DialogService.Close ao confirmar, ou null ao cancelar.
   A página chamadora é responsável pelo PUT api/coordenador/propostas/{id}/rejeitar e pelo
   reload do dashboard. *@
@using TccManager.Shared.DTOs
@inject DialogService DialogService

<RadzenStack Gap="1rem" class="rz-p-4" style="min-width: 320px;">
    <EditForm Model="rejeicao" OnValidSubmit="Confirmar">
        <DataAnnotationsValidator />
        <RadzenStack Gap="1rem">
            <div>
                <RadzenFormField Text="Motivo da Rejeição" Variant="Variant.Outlined" style="width: 100%;">
                    <RadzenTextArea Name="Motivo" @bind-Value="rejeicao.Motivo" Rows="4" style="width: 100%;" />
                </RadzenFormField>
                <ValidationMessage For="@(() => rejeicao.Motivo)" />
            </div>

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenButton Text="Cancelar" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Click="@Cancelar" />
                <RadzenButton ButtonType="ButtonType.Submit" Text="Rejeitar Proposta" Icon="cancel" ButtonStyle="ButtonStyle.Danger" />
            </RadzenStack>
        </RadzenStack>
    </EditForm>
</RadzenStack>

@code {
    private RejeicaoDto rejeicao = new();

    private void Confirmar() => DialogService.Close(rejeicao.Motivo);

    private void Cancelar() => DialogService.Close(null);
}
