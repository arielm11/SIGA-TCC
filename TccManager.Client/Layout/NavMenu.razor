@using Microsoft.AspNetCore.Components.Authorization
@using TccManager.Client.Providers
@using Blazored.LocalStorage

@inject AuthenticationStateProvider AuthStateProvider
@inject ILocalStorageService LocalStorage
@inject NavigationManager Navigation
@inject IHttpClientFactory HttpClientFactory
@inject NotificationService NotificationService

<RadzenStack Gap="0" class="rz-p-3" style="height: 100%;">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-3">
        <RadzenIcon Icon="school" />
        <RadzenText TextStyle="TextStyle.H6" class="rz-my-0">SIGA TCC</RadzenText>
    </RadzenStack>

    <RadzenPanelMenu Multiple="false" DisplayStyle="MenuItemDisplayStyle.IconAndText">
        <RadzenPanelMenuItem Text="Home" Path="" Match="NavLinkMatch.All" Icon="home" />

        <AuthorizeView Roles="Admin">
            <Authorized>
                @foreach (var atalho in AtalhosPerfil.Admin)
                {
                    <RadzenPanelMenuItem Text="@atalho.Rotulo" Path="@atalho.Rota" Icon="@atalho.Icone" />
                }
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="Aluno">
            <Authorized>
                @foreach (var atalho in AtalhosPerfil.Aluno)
                {
                    <RadzenPanelMenuItem Text="@atalho.Rotulo" Path="@atalho.Rota" Icon="@atalho.Icone" />
                }
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="Professor">
            <Authorized>
                @foreach (var atalho in AtalhosPerfil.Professor)
                {
                    <RadzenPanelMenuItem Text="@atalho.Rotulo" Path="@atalho.Rota" Icon="@atalho.Icone" />
                }
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="Coordenador">
            <Authorized>
                @foreach (var atalho in AtalhosPerfil.Coordenador)
                {
                    <RadzenPanelMenuItem Text="@atalho.Rotulo" Path="@atalho.Rota" Icon="@atalho.Icone" />
                }
            </Authorized>
        </AuthorizeView>
    </RadzenPanelMenu>

    <div style="margin-top: auto;">
        <AuthorizeView>
            <Authorized>
                <RadzenProfileMenu Click="@OnMenuItemClick">
                    <Template>
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenIcon Icon="account_circle" />
                            <RadzenText TextStyle="TextStyle.Body1" class="rz-my-0">@context.User.Identity?.Name</RadzenText>
                        </RadzenStack>
                    </Template>
                    <ChildContent>
                        <RadzenProfileMenuItem Text="Meus Dados" Icon="person" Path="meus-dados" />
                        <RadzenProfileMenuItem Text="Sair" Icon="logout" Value="sair" />
                    </ChildContent>
                </RadzenProfileMenu>
            </Authorized>
        </AuthorizeView>
    </div>
</RadzenStack>

@code {
    private async Task OnMenuItemClick(RadzenProfileMenuItem args)
    {
        if (args.Value == "sair")
        {
            await Logout();
        }
    }

    // Achado L2 da revisão de segurança (#171, A07): poucas tentativas com um pequeno backoff
    // antes de desistir — o cookie HttpOnly siga_refresh só pode ser expirado pelo servidor
    // (Set-Cookie da resposta de /logout); o JS/Blazor não tem nenhuma forma de limpá-lo no
    // navegador.
    private const int MaxTentativasLogout = 3;

    private async Task Logout()
    {
        // Issue #171 (D8): sempre chama o servidor — o Client não tem mais como saber se
        // existe cookie de refresh (HttpOnly, ilegível por JS). O 204 idempotente no servidor
        // cobre também o caso "sem cookie nenhum".
        var logoutConfirmadoPeloServidor = await TentarLogoutNoServidorAsync();

        // Mesmo se o servidor não confirmar, a UI local não pode prender o usuário numa tela
        // de erro: o estado local já não tem mais sessão ativa daqui para frente.
        await LocalStorage.RemoveItemAsync("authToken");
        // D9: limpeza da chave legada — não é mais escrita nem lida, só removida.
        await LocalStorage.RemoveItemAsync("refreshToken");
        ((CustomAuthStateProvider)AuthStateProvider).NotifyUserLogout();

        if (!logoutConfirmadoPeloServidor)
        {
            NotificationService.NotificarErro(
                "Logout não confirmado pelo servidor",
                "Você foi desconectado neste navegador, mas o servidor não confirmou o encerramento da sessão depois de várias tentativas. Se este é um computador compartilhado, feche completamente o navegador agora — caso contrário, sua sessão pode continuar acessível por até 7 dias.",
                10000);
        }

        Navigation.NavigateTo("/login");
    }

    /// <summary>
    /// Best-effort com poucas tentativas e backoff: falha de rede/transporte é tentada de
    /// novo antes de desistir, mas não impede o logout local em nenhum caso (ver Logout()).
    /// Retorna <c>true</c> somente se o servidor respondeu com sucesso (2xx) em alguma
    /// tentativa — é a única forma de o cookie <c>siga_refresh</c> ter sido de fato expirado.
    /// </summary>
    private async Task<bool> TentarLogoutNoServidorAsync()
    {
        var authRawClient = HttpClientFactory.CreateClient("AuthRaw");

        for (var tentativa = 1; tentativa <= MaxTentativasLogout; tentativa++)
        {
            try
            {
                var resposta = await authRawClient.PostAsync("api/auth/logout", null);
                if (resposta.IsSuccessStatusCode)
                {
                    return true;
                }

                Console.WriteLine($"Logout: servidor respondeu {(int)resposta.StatusCode} na tentativa {tentativa}/{MaxTentativasLogout}.");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Logout: falha de rede na tentativa {tentativa}/{MaxTentativasLogout}: {ex.Message}");
            }

            if (tentativa < MaxTentativasLogout)
            {
                await Task.Delay(TimeSpan.FromMilliseconds(300 * tentativa));
            }
        }

        return false;
    }
}
