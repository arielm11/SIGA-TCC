<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>b00fcbf0-d83b-46cd-b719-36445405992b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="FluentValidation" Version="12.2.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <!-- Força a versão transitiva de System.Security.Cryptography.Pkcs trazida pelo MimeKit:
         GHSA-2fmv-rv2c-59x7/GHSA-846f-f764-76mx (CVE-2026-70162/CVE-2026-84008, DoS). MimeKit
         4.18.1 (via MailKit) exige Pkcs >= 10.0.0, e a linha 10.x só corrige essas CVEs a
         partir de 10.0.13 (10.0.0-10.0.12 são vulneráveis) — por isso 10.0.13, não 9.0.21. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.21" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.21" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.21" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.21">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.21" />
    <!-- Dependabot propôs 10.0.13 (PR #218) — rejeitado: mistura a linha .NET 10 no
         toolchain fixado em 9.0.100 (global.json) sem benefício, mesmo raciocínio do PR #207
         (DevServer). Mantido em 9.0.21, igual ao resto da família EFCore. Reavaliar quando o
         projeto migrar pra .NET 10. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.21">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TccManager.Shared\TccManager.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Issue #75: expõe o construtor internal de teste de MailKitEmailService (seam para
         injetar um SmtpClient com certificado de teste confiado, sem tocar no construtor de
         produção nem no registro de DI). -->
    <InternalsVisibleTo Include="TccManager.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Migrations\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\EmailTemplates\*.html" />
  </ItemGroup>

</Project>
